@bff = http://localhost:5181
@session = prototype-session
@conversation = prototype-conversation

### Registered agents
GET {{bff}}/api/agents

### Host/vendor modes
GET {{bff}}/api/vendors

### Start a manually paced run (the request stays open)
POST {{bff}}/api/chat/stream
Content-Type: application/json
Accept: text/event-stream

{
  "message": "What is an AI agent?",
  "agent": "ChatAgent",
  "sessionId": "{{session}}",
  "conversationId": "{{conversation}}",
  "manual": true,
  "stepDelayMs": 600
}

### Advance the running stream from a second request
POST {{bff}}/api/chat/control
Content-Type: application/json

{ "sessionId": "{{session}}", "action": "next" }

### Stop
POST {{bff}}/api/chat/control
Content-Type: application/json

{ "sessionId": "{{session}}", "action": "stop" }

### Reset after stopping
POST {{bff}}/api/chat/reset
Content-Type: application/json

{ "conversationId": "{{conversation}}" }

### Unsupported API paths never return the React document
GET {{bff}}/api/unknown