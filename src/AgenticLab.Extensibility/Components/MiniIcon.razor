<svg class="mini-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @Glyph(Name)
</svg>

@code {
    /// <summary>Which glyph to draw: send, play, next, prev, pause, stop, new, live, expand or close.</summary>
    [Parameter] public string Name { get; set; } = string.Empty;

    private static RenderFragment Glyph(string name) => name switch
    {
        "send" => @<g><path d="M12 19V5" /><path d="M5 12l7-7 7 7" /></g>,
        "play" => @<path d="M7 4.5 19 12 7 19.5z" />,
        "next" => @<g><path d="M6 4.5 16 12 6 19.5z" /><path d="M19 5v14" /></g>,
        "prev" => @<g><path d="M18 4.5 8 12 18 19.5z" /><path d="M5 5v14" /></g>,
        "pause" => @<g><path d="M9 5v14" /><path d="M15 5v14" /></g>,
        "stop" => @<rect x="6" y="6" width="12" height="12" rx="1.5" />,
        "close" => @<g><path d="m18 6-12 12" /><path d="m6 6 12 12" /></g>,
        "new" => @<g><path d="M12 5v14" /><path d="M5 12h14" /></g>,
        "live" => @<g><circle cx="12" cy="12" r="3" /><path d="M6.3 6.3a8 8 0 0 0 0 11.4" /><path d="M17.7 17.7a8 8 0 0 0 0-11.4" /></g>,
        "expand" => @<g><path d="M9 3H5a2 2 0 0 0-2 2v4" /><path d="M15 3h4a2 2 0 0 1 2 2v4" /><path d="M9 21H5a2 2 0 0 1-2-2v-4" /><path d="M15 21h4a2 2 0 0 0 2-2v-4" /></g>,
        _ => @<circle cx="12" cy="12" r="8" />,
    };
}