@* The left Controls panel, reorganised from two stacked cards into a tabbed view. A minimal
   icon-over-label tab strip switches between Chat (FlowChat), Settings (FlowControls) and Workspace
   (skills + custom instructions). The chat and settings tabs reuse the existing FlowChat/FlowControls
   components unchanged; the run/view state cascades down to all of them. *@

<div class="controls-tabs">
    <div class="tab-strip" role="tablist">
        @foreach (var tab in _tabs)
        {
            <button type="button" role="tab"
                    class="@(View.ActiveControlsTab == tab ? "tab selected" : "tab")"
                    aria-selected="@(View.ActiveControlsTab == tab)"
                    @onclick="@(() => View.ActiveControlsTab = tab)">
                <span class="tab-icon">@Icon(tab)</span>
                <span class="tab-label">@Label(tab)</span>
                @if (Badge(tab) is { } badge)
                {
                    <span class="tab-badge">@badge</span>
                }
            </button>
        }
    </div>

    <div class="tab-body" role="tabpanel">
        @switch (View.ActiveControlsTab)
        {
            case ControlsTab.Chat:
                <FlowChat />
                break;
            case ControlsTab.Settings:
                <FlowControls />
                break;
            case ControlsTab.Workspace:
                <ControlsWorkspace />
                break;
            case ControlsTab.Telemetry:
                <ControlsTelemetry />
                break;
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;

    private static readonly ControlsTab[] _tabs =
    {
        ControlsTab.Chat,
        ControlsTab.Settings,
        ControlsTab.Workspace,
        // Telemetry hidden for now.
    };

    private static string Label(ControlsTab tab) => tab switch
    {
        ControlsTab.Chat => "Chat",
        ControlsTab.Settings => "Settings",
        ControlsTab.Workspace => "Workspace",
        ControlsTab.Telemetry => "Telemetry",
        _ => tab.ToString(),
    };

    /// <summary>A small, minimal line icon for each tab, shown above its label in the strip.</summary>
    private static RenderFragment Icon(ControlsTab tab) => tab switch
    {
        ControlsTab.Chat => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>,
        ControlsTab.Settings => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>,
        ControlsTab.Workspace => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" /></svg>,
        _ => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9" /></svg>,
    };

    /// <summary>A small count badge on a tab when it has live content to surface, or null when empty.</summary>
    private int? Badge(ControlsTab tab) => tab switch
    {
        ControlsTab.Workspace => Run.KnownSkills.Count + Run.KnownInstructions.Count is var n and > 0 ? n : null,
        _ => null,
    };
}
