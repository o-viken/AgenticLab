@* The control part of the left panel: agent picker, per-tool toggles, the optional workspace input,
   the auto-step delay and the stepping mode. Reads and writes the shared view/run state. The vendor
   picker now lives in the left-edge VendorRail; the chat (message box, run buttons, answer box,
   last-response echo) lives in the sibling FlowChat component. *@

<section class="controls settings-controls">
    <div class="control">
        <label for="agent">Agent</label>
        <select id="agent" @bind="View.SelectedAgent" @bind:after="Run.OnAgentChangedAsync" disabled="@Run.Running">
            @foreach (var agent in View.AvailableAgents)
            {
                <option value="@agent.Name">@agent.Label</option>
            }
            @if (View.WorkspaceAgentChoices.Count > 0)
            {
                <option disabled>──────────</option>
                @foreach (var agent in View.WorkspaceAgentChoices)
                {
                    <option value="@agent.Name">@agent.Label</option>
                }
            }
        </select>
    </div>

    <div class="control">
        <label for="delay">Auto step delay <span>@View.StepDelayMs ms</span></label>
        <input id="delay" type="range" min="0" max="3000" step="50"
               @bind="View.StepDelayMs" @bind:event="oninput" @bind:after="Run.SetDelayAsync"
               disabled="@(View.Mode == FlowMode.Manual)" />
    </div>

    <div class="control">
        <label>Stepping</label>
        <div class="mode-toggle">
            <button type="button" class="@(View.Mode == FlowMode.Auto ? "selected" : "")"
                    disabled="@Run.Running" @onclick="@(() => View.Mode = FlowMode.Auto)">Auto</button>
            <button type="button" class="@(View.Mode == FlowMode.Manual ? "selected" : "")"
                    disabled="@Run.Running" @onclick="@(() => View.Mode = FlowMode.Manual)">Manual</button>
        </div>
    </div>

    @* Tools always occupies its own full-width row (with a placeholder when the agent
       has none) so switching agents never reflows the primary controls above. *@
    <div class="control tools-control">
        <label>Tools</label>
        @if (View.SelectedAgentToolNames.Count > 0)
        {
            <div class="tool-toggles">
                @foreach (var tool in View.SelectedAgentToolNames)
                {
                    <label class="check tool-check @View.ToolRiskClass(tool)" title="@View.ToolRiskTitle(tool)">
                        <input type="checkbox" checked="@View.IsToolEnabled(tool)" disabled="@Run.Running"
                               @onchange="@(e => View.SetToolEnabled(tool, (bool)e.Value!))" />
                        @tool
                    </label>
                }
            </div>
        }
        else
        {
            <p class="tools-empty">No tools for this agent</p>
        }
    </div>

    @if (View.SelectedAgentRequiresWorkspace)
    {
        <div class="control message workspace-control">
            <label for="workspace">Workspace</label>
            <input id="workspace" @bind="View.Workspace" @bind:event="oninput" @onblur="Run.RefreshWorkspaceContextAsync"
                   placeholder="Absolute path to a folder the agent may edit, e.g. C:\code\my-app"
                   disabled="@Run.Running" />
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;
}
