@* The control part of the left panel: per-tool toggles, the optional workspace input, the auto-step
   delay and the stepping mode. Reads and writes the shared view/run state. The vendor picker lives in
   the left-edge VendorRail; the agent picker and chat (message box, run buttons, answer box) live in
   the sibling FlowChat component. *@

<section class="controls settings-controls">
    <div class="control">
        <label for="delay">Auto step delay <span>@View.Options.StepDelayMs ms</span></label>
        <input id="delay" type="range" min="0" max="3000" step="50"
               @bind="View.Options.StepDelayMs" @bind:event="oninput" @bind:after="Run.SetDelayAsync"
               disabled="@(View.Options.Mode == FlowMode.Manual)" />
    </div>

    <div class="control">
        <label>Stepping</label>
        <div class="mode-toggle">
            <button type="button" class="@(View.Options.Mode == FlowMode.Auto ? "selected" : "")"
                    disabled="@Run.Running" @onclick="@(() => View.Options.Mode = FlowMode.Auto)">Auto</button>
            <button type="button" class="@(View.Options.Mode == FlowMode.Manual ? "selected" : "")"
                    disabled="@Run.Running" @onclick="@(() => View.Options.Mode = FlowMode.Manual)">Manual</button>
        </div>
    </div>

    <fieldset class="control breakpoints-control">
        <legend>Breakpoints</legend>
        <div class="breakpoint-grid">
            @foreach (var option in RunOptions.BreakpointOptions)
            {
                <label class="check">
                    <input type="checkbox" checked="@View.Options.IsBreakpointEnabled(option.Kind)"
                           disabled="@Run.BreakpointSettingsPending"
                           @onchange="@(args => Run.SetBreakpointAsync(option.Kind, args.Value is true))" />
                    <span>@option.Label</span>
                </label>
            }
        </div>
        <FlowBreakpointControls />
    </fieldset>

    @* Tools always occupies its own full-width row (with a placeholder when the agent
       has none) so switching agents never reflows the primary controls above. *@
    <div class="control tools-control">
        <label>Tools</label>
        @if (View.Agent.ToolNames.Count > 0)
        {
            <div class="tool-toggles">
                @foreach (var tool in View.Agent.ToolNames)
                {
                    <label class="check tool-check @View.Agent.ToolRiskClass(tool)" title="@View.Agent.ToolRiskTitle(tool)">
                        <input type="checkbox" checked="@View.Options.IsToolEnabled(tool)" disabled="@Run.Running"
                               @onchange="@(e => View.Options.SetToolEnabled(tool, (bool)e.Value!))" />
                        @tool
                    </label>
                }
            </div>
        }
        else
        {
            <p class="tools-empty">No tools for this agent</p>
        }
        @if (View.Agent.ToolMappingLines.Count > 0)
        {
            <div class="tool-mappings">
                <span class="tool-mappings-title">Declared in agent file → mapped tool</span>
                <ul>
                    @foreach (var line in View.Agent.ToolMappingLines)
                    {
                        <li class="@(line.Dropped ? "dropped" : "")">
                            <span class="declared">
                                @foreach (var token in line.Declared)
                                {
                                    <code>@token</code>
                                }
                            </span>
                            <span class="arrow">→</span>
                            @if (line.Dropped)
                            {
                                <span class="dropped-label">no matching tool (dropped)</span>
                            }
                            else
                            {
                                <code class="mapped">@line.Mapped</code>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    @if (View.Agent.RequiresWorkspace)
    {
        <div class="control message workspace-control">
            <label for="workspace">Workspace</label>
            <div class="workspace-picker">
                <input id="workspace" class="workspace-input" @bind="View.Workspace" @bind:event="oninput" @onblur="Run.Catalogs.RefreshWorkspaceContextAsync"
                       placeholder="Absolute path to a folder the agent may edit, e.g. C:\code\my-app"
                       disabled="@Run.Running" />
                @if (View.WorkspacePrefs.Suggestions.Count > 0)
                {
                    <button type="button" class="picker-toggle @(_pickerOpen ? "open" : "")" @onclick="TogglePicker"
                            disabled="@Run.Running" title="Browse repos from your base folders">
                        <span class="picker-caret">▾</span>
                    </button>
                }

                @if (_pickerOpen)
                {
                    var filtered = FilteredSuggestions();
                    <div class="picker-panel">
                        <input class="picker-filter" placeholder="Filter @View.WorkspacePrefs.Suggestions.Count repos…"
                               @bind="_pickerFilter" @bind:event="oninput" @onkeydown="OnPickerKeyDown" />
                        <ul class="picker-list">
                            @foreach (var suggestion in filtered)
                            {
                                <li>
                                    <button type="button"
                                            class="picker-item @(string.Equals(suggestion.Path, View.Workspace, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                            @onclick="() => SelectWorkspace(suggestion.Path)">
                                        <span class="picker-item-head">
                                            <span class="repo-name">@suggestion.Name</span>
                                            @if (suggestion.IsRecent)
                                            {
                                                <span class="repo-badge">recent</span>
                                            }
                                        </span>
                                        <span class="repo-path">@suggestion.Path</span>
                                    </button>
                                </li>
                            }
                            @if (filtered.Count == 0)
                            {
                                <li class="picker-empty">No matching repos</li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <label for="workspace-bases" class="bases-label">Repo base folders — one per line, to suggest repos above</label>
            <textarea id="workspace-bases" class="bases-input" rows="2" @bind="View.WorkspacePrefs.Bases"
                      @bind:after="Run.Catalogs.RefreshWorkspaceSuggestionsAsync"
                      placeholder="e.g. C:\Users\me\Documents\GitHub" disabled="@Run.Running"></textarea>
            @if (View.WorkspacePrefs.Suggestions.Count > 0)
            {
                <span class="bases-hint">@View.WorkspacePrefs.Suggestions.Count repo(s) found — click ▾ to browse</span>
            }
        </div>
    }

    @* Skills discovered in the workspace — a compact list (name only) that expands per item, each with an
       on/off toggle (skills default on). Disabling one removes it from the run. *@
    @if (View.Agent.SupportsSkills)
    {
        <div class="control resource-control">
            <label>Skills <span>@Run.Catalogs.KnownSkills.Count found</span></label>
            @if (Run.Catalogs.KnownSkills.Count == 0)
            {
                <p class="resource-empty">No skills in this workspace (add a skills/&lt;name&gt;/SKILL.md, .github/prompts/*.prompt.md or .claude/commands/*.md).</p>
            }
            else
            {
                <ul class="resource-list">
                    @foreach (var skill in Run.Catalogs.KnownSkills)
                    {
                        var expanded = _expandedSkills.Contains(skill.Name);
                        <li class="resource-item @(View.Options.IsSkillEnabled(skill.Name) ? "" : "off")" @key="skill.Name">
                            <div class="resource-row">
                                <input type="checkbox" checked="@View.Options.IsSkillEnabled(skill.Name)" disabled="@Run.Running"
                                       @onchange="@(e => View.Options.SetSkillEnabled(skill.Name, (bool)e.Value!))" />
                                <button type="button" class="resource-name" @onclick="@(() => ToggleSkill(skill.Name))">
                                    <span class="resource-caret @(expanded ? "open" : "")">▸</span>
                                    <span class="resource-title">⬡ @skill.Name@(Run.Catalogs.IsSkillLoaded(skill.Name) ? " · loaded" : "")</span>
                                </button>
                            </div>
                            @if (expanded)
                            {
                                <div class="resource-detail">@skill.Description</div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }

    @* Custom instructions discovered in the workspace — a compact expandable list. Instructions default
       OFF (opt-in); enable the ones this run should follow. Covers .github, .claude and AGENTS.md/CLAUDE.md. *@
    @if (View.Agent.SupportsInstructions)
    {
        <div class="control resource-control">
            <label>Custom instructions <span>@Run.Catalogs.KnownInstructions.Count found</span></label>
            @if (Run.Catalogs.KnownInstructions.Count == 0)
            {
                <p class="resource-empty">No custom instructions (add an instructions/*.instructions.md, .github/copilot-instructions.md, CLAUDE.md or AGENTS.md).</p>
            }
            else
            {
                <p class="resource-note">Off by default — tick the ones this run should follow.</p>
                <ul class="resource-list">
                    @foreach (var instruction in Run.Catalogs.KnownInstructions)
                    {
                        var expanded = _expandedInstructions.Contains(instruction.Name);
                        <li class="resource-item @(View.Options.IsInstructionEnabled(instruction.Name) ? "on" : "")" @key="instruction.Name">
                            <div class="resource-row">
                                <input type="checkbox" checked="@View.Options.IsInstructionEnabled(instruction.Name)" disabled="@Run.Running"
                                       @onchange="@(e => View.Options.SetInstructionEnabled(instruction.Name, (bool)e.Value!))" />
                                <button type="button" class="resource-name" @onclick="@(() => ToggleInstruction(instruction.Name))">
                                    <span class="resource-caret @(expanded ? "open" : "")">▸</span>
                                    <span class="resource-title">▤ @instruction.Name</span>
                                </button>
                            </div>
                            @if (expanded)
                            {
                                <div class="resource-detail">@instruction.Description</div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</section>

