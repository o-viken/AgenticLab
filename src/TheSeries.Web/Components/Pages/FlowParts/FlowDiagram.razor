<section class="diagram @View.DiagramClass">
    <div class="diagram-controls">
        <div class="diagram-control detail-level">
                <label>View preset <span class="preset-status" role="status">@(View.Diagram.Preset is null ? "Custom" : "")</span></label>
                <div class="mode-toggle preset-toggle" role="group" aria-label="View preset">
                <button type="button" class="@(View.Diagram.Preset == DiagramPreset.Basic ? "selected" : "")"
                        aria-pressed="@(View.Diagram.Preset == DiagramPreset.Basic ? "true" : "false")"
                    @onclick="@(() => View.Diagram.ApplyPreset(DiagramPreset.Basic))"
                    title="Reset display options to User and Agent host">Basic</button>
                <button type="button" class="@(View.Diagram.Preset == DiagramPreset.Technical ? "selected" : "")"
                        aria-pressed="@(View.Diagram.Preset == DiagramPreset.Technical ? "true" : "false")"
                    @onclick="@(() => View.Diagram.ApplyPreset(DiagramPreset.Technical))"
                    title="Reset display options to Model, loop counter, technical labels and Tools">Technical</button>
            </div>
        </div>

        <div class="diagram-control">
            <label>Where it runs</label>
            <div class="boundary-toggles">
                <label class="check"><input type="checkbox" @bind="View.Diagram.ShowEnvironment" /> Environment &amp; risk</label>
            </div>
        </div>

            <div class="diagram-control">
                <label>Details</label>
                <div class="boundary-toggles">
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowModel" /> Model</label>
                    <label class="check" title="Shown on the model connection"><input type="checkbox" @bind="View.Diagram.ShowLoop" disabled="@(!View.Diagram.ShowModel)" /> Loop counter</label>
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowTechnicalLabels" /> Technical labels</label>
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowTools" /> Tools</label>
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowSkills" /> Skills</label>
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowMcp" /> MCP servers</label>
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowA2A" /> A2A agents</label>
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ExpandHarness" /> Expand agent host</label>
                </div>
            </div>

            <div class="diagram-control">
                <label>Boundaries</label>
                <div class="boundary-toggles">
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowAgentBoundary" /> Agent</label>
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowHarnessBoundary" /> Agent host</label>
                </div>
            </div>

            <div class="diagram-control">
                <label>Model internals</label>
                <div class="boundary-toggles">
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowPromptSignature" /> Prompt signature</label>
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowInferenceView" /> Inference</label>
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowEmbeddingsView" /> Embeddings</label>
                    <label class="check"><input type="checkbox" @bind="View.Diagram.ShowNetworkView" /> Neural network</label>
                </div>
            </div>
    </div>

    @if (View.Diagram.ShowHarnessBoundary)
    {
        <div class="boundary harness-b">
            <span class="boundary-label">Agent host</span>
        </div>
    }
    @if (View.Diagram.ShowAgentBoundary)
    {
        <div class="boundary agent-b">
            <span class="boundary-label">Agent = Agent host + Model</span>
        </div>
    }
    @if (View.Diagram.ShowEnvironment)
    {
        <div class="boundary env-b">
            <span class="boundary-label">🔒 Your environment</span>
        </div>
    }

    <div class="node user @Run.Focus.NodeClass("user")">
        <span class="icon diagram-icon icon-user" aria-hidden="true"></span>
        <span class="title">User</span>
        <span class="subtitle">Human</span>
        @if (View.Diagram.ShowEnvironment)
        {
            <span class="env-badge env-yours" title="The browser on your own device">🖥️ Your browser</span>
        }
    </div>

    <div class="connector-group user-node">
        <div class="connector horizontal send @Run.Focus.ArrowClass("user-node-send")">
            <span class="flow-label">Input</span>
        </div>
        <div class="connector horizontal recv @Run.Focus.ArrowClass("user-node-recv")">
            <span class="flow-label">Reply</span>
        </div>
    </div>

    <div class="column center">
        @if (View.Diagram.ExpandHarness)
        {
            <HarnessAnatomy />
        }
        else
        {
            <HarnessNode />
        }

        @if (View.Diagram.ShowTools && Run.Focus.ActiveResourceInfo is { } resource
            && !(resource.Key == "a2a" && View.Diagram.ShowA2A && Run.Replay.DisplayA2A.ActiveAgent is not null))
        {
            <div class="connector vertical active"></div>
            <div class="resources">
                <div class="node resource active">
                    <span class="icon">@resource.Icon</span>
                    <span class="title">@resource.Title</span>
                    <span class="subtitle">@resource.Transport</span>
                    @if (!string.IsNullOrEmpty(Run.Focus.ActiveToolName))
                    {
                        <span class="resource-tool">🔧 @Run.Focus.ActiveToolName</span>
                    }
                    @if (!string.IsNullOrEmpty(Run.Focus.ActiveToolArgs))
                    {
                        <span class="resource-detail args" title="@Run.Focus.ActiveToolArgs">▶ @Run.Focus.ActiveToolArgs</span>
                    }
                    @if (!string.IsNullOrEmpty(Run.Focus.ActiveToolResult))
                    {
                        <span class="resource-detail result" title="@Run.Focus.ActiveToolResult">◀ @Run.Focus.ActiveToolResult</span>
                    }
                </div>
            </div>
        }
    </div>

    @if (View.Diagram.ShowModel)
    {
        <div class="connector-group loop">
            @if (View.Diagram.ShowLoop)
            {
                <div class="loop-badge @(Run.Focus.LoopActive ? "active" : "")" title="Model round trips">
                    <span class="loop-icon" aria-hidden="true">&#8635;</span>
                    <span class="loop-count">@Run.Focus.LoopLabel</span>
                </div>
            }
            <div class="connector horizontal send @Run.Focus.ArrowClass("node-llm-send")">
                <span class="flow-label">Prompt + tools</span>
            </div>
            <div class="connector horizontal recv @Run.Focus.ArrowClass("node-llm-recv")">
                <span class="flow-label">Response</span>
                @if (Run.Focus.ActiveArrow == "node-llm-recv" && !string.IsNullOrEmpty(Run.Focus.ResponseHint))
                {
                    <span class="response-hint">@Run.Focus.ResponseHint</span>
                }
            </div>
        </div>

        <div class="column right">
            <div class="node llm @Run.Focus.NodeClass("llm")">
                <ConceptInfoButton Id="llm" Title="Learn about the model" />
                <span class="icon diagram-icon icon-model" aria-hidden="true"></span>
                <span class="title">Model</span>
                <span class="subtitle">@View.Harness.LlmModelLabel</span>
                @if (View.Diagram.ShowEnvironment)
                {
                    <span class="env-badge env-cloud" title="A model hosted by a cloud provider, outside your environment">☁️ Cloud service</span>
                }
                @if (View.Concepts.ShowConcepts && View.Diagram.ShowMcp)
                {
                    <button type="button" class="concept-mcp" title="Learn about MCP"
                            @onclick="@(() => View.Concepts.OpenConcept("mcp"))" @onclick:stopPropagation="true">What is MCP?</button>
                }
            </div>
        </div>
    }

    @if (View.Diagram.ShowA2A && Run.Replay.DisplayA2A.Agents.Count > 0)
    {
        <div class="a2a-row">
            <A2AAgents />
        </div>
    }

    @if (View.Diagram.ShowPromptSignature)
    {
        <div class="signature-row">
            <PromptSignature />
        </div>
    }

    @if (View.Diagram.ShowInferenceView)
    {
        <div class="inference-row">
            <Inference />
        </div>
    }

    @if (View.Diagram.ShowEmbeddingsView)
    {
        <div class="embeddings-row">
            <Embeddings />
        </div>
    }

    @if (View.Diagram.ShowNetworkView)
    {
        <div class="network-row">
            <Network />
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;
}
