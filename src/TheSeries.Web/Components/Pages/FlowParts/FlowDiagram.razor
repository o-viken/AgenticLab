@* The live data-flow diagram: User → merged Harness/Application node → LLM, with directional send/recv
   arrows, the loop badge, the optional boundary overlays and the per-perspective view controls. The
   merged node and its anatomy live in the HarnessNode / HarnessAnatomy sub-components. *@

<section class="diagram @View.PerspectiveClass">
    <div class="diagram-controls">
        <div class="diagram-control detail-level">
            <label>Detail level</label>
            <div class="detail-hint"><span>less</span><span class="detail-track"></span><span>more</span></div>
            <div class="mode-toggle perspective-toggle ladder">
                <button type="button" class="@(View.Perspective == Perspective.Simple ? "selected" : "")"
                        @onclick="@(() => View.Perspective = Perspective.Simple)"
                        title="User ↔ Service (the model is hidden inside)">Basic</button>
                <button type="button" class="@(View.Perspective == Perspective.NonTechnical ? "selected" : "")"
                        @onclick="@(() => View.Perspective = Perspective.NonTechnical)"
                        title="User → Application → LLM">Non-technical</button>
                <button type="button" class="@(View.Perspective == Perspective.Technical ? "selected" : "")"
                        @onclick="@(() => View.Perspective = Perspective.Technical)"
                        title="User → Client → AiService → LLM">Technical</button>
                <button type="button" class="@(View.Perspective == Perspective.Expert ? "selected" : "")"
                        @onclick="@(() => View.Perspective = Perspective.Expert)"
                        title="Full harness, tools and steps">Expert</button>
            </div>
        </div>

        <div class="diagram-control">
            <label>Where it runs</label>
            <div class="boundary-toggles">
                <label class="check"><input type="checkbox" @bind="View.ShowEnvironment" /> Environment &amp; risk</label>
            </div>
        </div>

        @if (View.Perspective == Perspective.Expert)
        {
            <div class="diagram-control boundaries-control">
                <label>Boundaries</label>
                <div class="boundary-toggles">
                    <label class="check"><input type="checkbox" @bind="View.ShowAgentBoundary" /> Agent</label>
                </div>
            </div>

            <div class="diagram-control boundaries-control">
                <label>Anatomy</label>
                <div class="boundary-toggles">
                    <label class="check"><input type="checkbox" @bind="View.ExpandHarness" /> Expand harness</label>
                    <label class="check"><input type="checkbox" @bind="View.ShowPromptSignature" /> Prompt signature</label>
                    <label class="check"><input type="checkbox" @bind="View.ShowInferenceView" /> Inference</label>
                    <label class="check"><input type="checkbox" @bind="View.ShowEmbeddingsView" /> Embeddings</label>
                    <label class="check"><input type="checkbox" @bind="View.ShowNetworkView" /> Neural network</label>
                </div>
            </div>
        }
    </div>

    @if (View.Perspective == Perspective.Expert && View.ShowHarnessBoundary)
    {
        <div class="boundary harness-b">
            <span class="boundary-label">Harness</span>
        </div>
    }
    @if (View.Perspective == Perspective.Expert && View.ShowAgentBoundary)
    {
        <div class="boundary agent-b">
            <span class="boundary-label">Agent</span>
        </div>
    }
    @if (View.ShowEnvironment)
    {
        <div class="boundary env-b">
            <span class="boundary-label">🔒 Your environment</span>
        </div>
    }

    <div class="node user @Run.NodeClass("user")">
        <span class="icon">🧑</span>
        <span class="title">User</span>
        <span class="subtitle">Human</span>
        @if (View.ShowEnvironment)
        {
            <span class="env-badge env-yours" title="The browser on your own device">🖥️ Your browser</span>
        }
    </div>

    <div class="connector-group user-node">
        <div class="connector horizontal send @Run.ArrowClass("user-node-send")">
            <span class="flow-label">Input ▶</span>
        </div>
        <div class="connector horizontal recv @Run.ArrowClass("user-node-recv")">
            <span class="flow-label">◀ Reply</span>
        </div>
    </div>

    <div class="column center">
        @if (View.Perspective == Perspective.Expert && View.ExpandHarness)
        {
            <HarnessAnatomy />
        }
        else
        {
            <HarnessNode />
        }

        @if (View.Perspective == Perspective.Expert && Run.ActiveResourceInfo is { } resource)
        {
            <div class="connector vertical active"></div>
            <div class="resources">
                <div class="node resource active">
                    <span class="icon">@resource.Icon</span>
                    <span class="title">@resource.Title</span>
                    <span class="subtitle">@resource.Transport</span>
                    @if (!string.IsNullOrEmpty(Run.ActiveToolName))
                    {
                        <span class="resource-tool">🔧 @Run.ActiveToolName</span>
                    }
                    @if (!string.IsNullOrEmpty(Run.ActiveToolArgs))
                    {
                        <span class="resource-detail args" title="@Run.ActiveToolArgs">▶ @Run.ActiveToolArgs</span>
                    }
                    @if (!string.IsNullOrEmpty(Run.ActiveToolResult))
                    {
                        <span class="resource-detail result" title="@Run.ActiveToolResult">◀ @Run.ActiveToolResult</span>
                    }
                </div>
            </div>
        }
    </div>

    @if (View.Perspective != Perspective.Simple)
    {
        <div class="connector-group loop">
            @if (View.Perspective != Perspective.NonTechnical)
            {
                <div class="loop-badge @(Run.LoopActive ? "active" : "")">
                    <span class="loop-icon">🔁</span>
                    <span class="loop-count">@Run.LoopLabel</span>
                </div>
            }
            <div class="connector horizontal send @Run.ArrowClass("node-llm-send")">
                <span class="flow-label">Prompt + Tools ▶</span>
            </div>
            <div class="connector horizontal recv @Run.ArrowClass("node-llm-recv")">
                <span class="flow-label">◀ Response</span>
                @if (Run.ActiveArrow == "node-llm-recv" && !string.IsNullOrEmpty(Run.ResponseHint))
                {
                    <span class="response-hint">@Run.ResponseHint</span>
                }
            </div>
        </div>

        <div class="column right">
            <div class="node llm @Run.NodeClass("llm")">
                <ConceptInfoButton Id="llm" Title="Learn about LLMs" />
                <span class="icon">🤖</span>
                <span class="title">LLM</span>
                <span class="subtitle">@View.LlmModelLabel</span>
                @if (View.ShowEnvironment)
                {
                    <span class="env-badge env-cloud" title="A model hosted by a cloud provider, outside your environment">☁️ Cloud service</span>
                }
                @if (View.ShowConcepts && View.Perspective == Perspective.Expert)
                {
                    <button type="button" class="concept-mcp" title="Learn about MCP"
                            @onclick="@(() => View.OpenConcept("mcp"))" @onclick:stopPropagation="true">What is MCP?</button>
                }
            </div>
        </div>
    }

    @if (View.Perspective == Perspective.Expert && View.ShowPromptSignature)
    {
        <div class="signature-row">
            <PromptSignature />
        </div>
    }

    @if (View.Perspective == Perspective.Expert && View.ShowInferenceView)
    {
        <div class="inference-row">
            <Inference />
        </div>
    }

    @if (View.Perspective == Perspective.Expert && View.ShowEmbeddingsView)
    {
        <div class="embeddings-row">
            <Embeddings />
        </div>
    }

    @if (View.Perspective == Perspective.Expert && View.ShowNetworkView)
    {
        <div class="network-row">
            <Network />
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;
}
