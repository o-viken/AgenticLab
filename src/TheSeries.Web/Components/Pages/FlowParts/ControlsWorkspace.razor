@* The Workspace tab of the left Controls panel: the workspace context the selected agent picks up —
   the discovered skills (loaded on demand via ReadSkill) and the always-injected custom instructions.
   Read-only view over the run's known skills/instructions, which the run controller refreshes whenever
   the agent or workspace changes. Shows guidance when the agent uses no workspace or none are present. *@

<section class="controls workspace-controls">
    @if (!View.SelectedAgentRequiresWorkspace)
    {
        <div class="control">
            <label>Workspace</label>
            <p class="empty">This agent doesn't use a workspace, so it has no skills or custom instructions.</p>
        </div>
    }
    else
    {
        <div class="control">
            <label>Skills <span>@Run.KnownSkills.Count found</span></label>
            @if (Run.KnownSkills.Count == 0)
            {
                <p class="empty">No skills in this workspace (add a skills/&lt;name&gt;/SKILL.md file).</p>
            }
            else
            {
                <ul class="ws-list">
                    @foreach (var skill in Run.KnownSkills)
                    {
                        <li class="ws-item @(Run.IsSkillLoaded(skill.Name) ? "loaded" : "")" @key="skill.Name">
                            <span class="ws-name">⬡ @skill.Name@(Run.IsSkillLoaded(skill.Name) ? " · loaded" : "")</span>
                            <span class="ws-desc">@skill.Description</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="control">
            <label>Custom instructions <span>@Run.KnownInstructions.Count found</span></label>
            @if (Run.KnownInstructions.Count == 0)
            {
                <p class="empty">No custom instructions (add an instructions/*.instructions.md file).</p>
            }
            else
            {
                <ul class="ws-list">
                    @foreach (var instruction in Run.KnownInstructions)
                    {
                        <li class="ws-item" @key="instruction.Name">
                            <span class="ws-name">▤ @instruction.Name</span>
                            <span class="ws-desc">@instruction.Description</span>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;
}
