@* The growing "context" visualization inside the harness anatomy: a bar scaled to the captured
   step-data size plus one chip per content event, with the carried-over conversation history shown
    first as dimmed chips. During replay only content through the cursor is shown. *@

@{
     var context = Run.DisplayContext;
}
<div class="context-stack @(Run.Replaying ? "replay" : null)">
    <div class="context-head">
        <span class="context-title-group">
            <ConceptInfoButton Id="context" Title="Learn about the context" />
            <span class="context-title">Context</span>
        </span>
        <span class="context-meta">@context.Count content entr@(context.Count == 1 ? "y" : "ies") · @(context.Chars is int chars ? $"~{chars:N0} chars" : "size not captured")</span>
    </div>
    @if (Run.Replaying)
    {
        <div class="context-position">
            <span class="context-mode">Replay · exchange @(Run.SelectedExchange?.Number)</span>
            @if (Run.SelectedStage is { } stage)
            {
                <span>@(stage.Turn > 0 ? $"T{stage.Turn} · " : null)@ExecutionReplayBuilder.StageTitle(stage)</span>
            }
        </div>
    }
    <div class="context-bar" aria-hidden="true"><span style="width:@(context.BarWidth)%"></span></div>
    @if (context.Count == 0)
    {
        <span class="context-empty">@(Run.Replaying ? "No content captured at this stage." : "Content grows as the agent runs.")</span>
    }
    else
    {
        <ol class="context-chips">
            @if (context.History.Count > 0)
            {
                <li class="ctx-divider">Earlier in this conversation</li>
                @foreach (var entry in context.History)
                {
                    @ContextChip(entry)
                }
                @if (context.Current.Count > 0)
                {
                    <li class="ctx-divider">This exchange</li>
                }
            }
            @foreach (var entry in context.Current)
            {
                @ContextChip(entry)
            }
        </ol>
    }
</div>

@code {
    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;

    // Renders a single Context chip. History chips are dimmed via the extra "history" class and omit
    // the per-turn badge.
    private RenderFragment ContextChip(ContextEntry entry)
    {
        var cssClass = entry.History ? $"ctx {entry.Source} history" : $"ctx {entry.Source}";
        return @<li class="@cssClass">
            <div class="ctx-row">
                @if (entry.Turn is int turn)
                {
                    <span class="ctx-turn">T@(turn)</span>
                }
                <span class="ctx-label">@entry.Label</span>
            </div>
            @if (!string.IsNullOrEmpty(entry.Preview))
            {
                <span class="ctx-preview">@entry.Preview</span>
            }
        </li>;
    }
}
