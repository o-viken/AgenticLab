@* The conversation part of the left panel: a scrollable log (oldest at the top, newest at the bottom)
   and a composer pinned to the bottom — the agent picker, the message box, the run/stepping buttons and
   the inline answer box (shown when an agent's AskQuestion tool is waiting). The agent's live status is
   announced on its own entry: a status chip, the turn meta and a one-line note saying where the run has
   got to and what it is waiting on. Reads and writes the shared view/run state. The remaining settings
   (vendor in the VendorRail; stepping, tools and workspace in the sibling FlowControls) live elsewhere. *@
@inject IJSRuntime JS
<section class="controls chat-controls">
    <div class="chat-log" @ref="_logRef">
        @if (Run.Turns.Count == 0 && string.IsNullOrWhiteSpace(Run.RunMessage))
        {
            <p class="chat-empty">No messages yet — send something to start the conversation.</p>
        }
        else
        {
            @foreach (var turn in Run.Turns)
            {
                <div class="turn" @key="turn">
                    <article class="entry user">
                        <header class="entry-head"><span class="role">You</span></header>
                        <p>@turn.Message</p>
                    </article>
                    <article class="entry agent @(string.IsNullOrWhiteSpace(turn.Error) ? "" : "failed")">
                        <header class="entry-head"><span class="role">@(turn.Agent ?? "Agent")</span></header>
                        @if (!string.IsNullOrWhiteSpace(turn.Error))
                        {
                            <p class="error">@turn.Error</p>
                        }
                        else
                        {
                            <p>@turn.Reply</p>
                        }
                    </article>
                </div>
            }

            @* The current/most-recent exchange. It lives in RunMessage/Reply until the next send archives
               it into Turns, so render it here for both the in-progress run and the just-finished one. *@
            @if (!string.IsNullOrWhiteSpace(Run.RunMessage))
            {
                <div class="turn pending">
                    <article class="entry user">
                        <header class="entry-head"><span class="role">You</span></header>
                        <p>@Run.RunMessage</p>
                    </article>
                    <article class="entry agent @(Run.Activity == AgentActivity.Failed ? "failed" : "")">
                        <header class="entry-head">
                            <span class="role">@(View.SelectedAgent ?? "Agent")</span>
                            @if (Run.AgentStatusLabel is { } status)
                            {
                                <span class="status @StatusClass" role="status">
                                    <span class="status-mark" aria-hidden="true"></span>@status
                                </span>
                            }
                            @if (Run.TurnMeta is { } meta)
                            {
                                <span class="turn-meta @(Run.LoopActive ? "live" : "")">@meta</span>
                            }
                        </header>
                        @if (!string.IsNullOrWhiteSpace(Run.Error))
                        {
                            <p class="error">@Run.Error</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(Run.Reply))
                        {
                            <p>@Run.Reply</p>
                        }
                        @if (Run.AgentStatusNote is { } note)
                        {
                            <p class="status-note">@note</p>
                        }
                    </article>
                </div>
            }
        }
    </div>

    @if (Run.AwaitingAnswer)
    {
        <div class="control message ask-question">
            <label for="answer">The agent is asking</label>
            <p class="ask-question-text">@Run.PendingQuestion</p>
            <div class="ask-question-row">
                <input id="answer" @bind="Run.AnswerText" @bind:event="oninput"
                       placeholder="Type your answer…" @onkeydown="OnAnswerKeyDownAsync" />
                <button class="send-icon" @onclick="Run.SubmitAnswerAsync" title="Send your answer" aria-label="Send your answer"
                        disabled="@string.IsNullOrWhiteSpace(Run.AnswerText)"><MiniIcon Name="send" /></button>
            </div>
        </div>
    }

    <div class="chat-composer">
        <div class="control message">
            <label for="message">Message <span class="message-hint">Shift+Enter for a new line</span></label>
            <textarea id="message" rows="1" data-enter-submit @bind="View.Message" @bind:event="oninput"
                      placeholder="Ask something, e.g. How tall is the Eiffel Tower in metres?"
                      disabled="@Run.Running" @onkeydown="OnKeyDownAsync"></textarea>
        </div>

        <div class="control agent-select">
            <label for="agent">Agent</label>
            <select id="agent" aria-label="Agent" title="Agent" @bind="View.SelectedAgent" @bind:after="Run.OnAgentChangedAsync" disabled="@Run.Running">
                @foreach (var agent in View.AvailableAgents)
                {
                    <option value="@agent.Name">@agent.Label</option>
                }
                @if (View.WorkspaceAgentChoices.Count > 0)
                {
                    <option disabled>──────────</option>
                    @foreach (var agent in View.WorkspaceAgentChoices)
                    {
                        <option value="@agent.Name">@agent.Label</option>
                    }
                }
            </select>
        </div>

        <div class="composer-actions">
            <FlowBreakpointControls ShowReason="false" />

            @if (!Run.BreakpointPaused)
            {
                @if (!Run.Running)
                {
                    <button class="chip" @onclick="Run.NewConversationAsync" title="Forget the conversation history and start fresh.">
                        <MiniIcon Name="new" />New conversation
                    </button>
                }
                else if (View.Mode == FlowMode.Manual)
                {
                    <button class="chip" @onclick="Run.NextAsync" disabled="@Run.AwaitingStep">
                        <MiniIcon Name="next" />@(Run.AwaitingStep ? "Waiting…" : "Next")
                    </button>
                    <button class="chip danger" @onclick="Run.StopAsync"><MiniIcon Name="stop" />Stop</button>
                }
                else
                {
                    <button class="chip" @onclick="Run.TogglePauseAsync">
                        <MiniIcon Name="@(Run.Paused ? "play" : "pause")" />@(Run.Paused ? "Resume" : "Pause")
                    </button>
                    <button class="chip danger" @onclick="Run.StopAsync"><MiniIcon Name="stop" />Stop</button>
                }
            }

            <button class="send-icon" @onclick="Run.SendAsync" title="Send" aria-label="Send"
                    disabled="@(Run.Running || string.IsNullOrWhiteSpace(View.Message) || (View.SelectedAgentRequiresWorkspace && string.IsNullOrWhiteSpace(View.Workspace)))">
                <MiniIcon Name="send" />
            </button>
        </div>

        @if (Run.ComposerHint is { } hint)
        {
            <p class="composer-hint">@hint</p>
        }
    </div>
</section>

@code {
    private ElementReference _logRef;

    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;

    // A held run still reads as "in progress", so the chip keeps its mark but stops spinning (.held).
    private string StatusClass => Run.Activity switch
    {
        AgentActivity.Failed => "failed",
        AgentActivity.AwaitingAnswer => "waiting",
        AgentActivity.Paused => "held",
        AgentActivity.AwaitingStep or AgentActivity.AtBreakpoint => "busy held",
        _ => "busy",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Keep the newest message in view as the conversation grows / the reply streams in, unless the
        // user has scrolled up to read earlier messages (handled by stickToBottom in panels.js).
        try
        {
            await JS.InvokeVoidAsync("theSeriesPanels.stickToBottom", _logRef);
        }
        catch
        {
            // JS may be unavailable during prerender; the next interactive render scrolls.
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        // Enter sends; Shift+Enter inserts a new line (the textarea handles the newline, while a
        // small guard in panels.js suppresses the newline for a plain Enter that we send on).
        if (args.Key == "Enter" && !args.ShiftKey && !Run.Running && !string.IsNullOrWhiteSpace(View.Message))
        {
            await Run.SendAsync();
        }
    }

    private async Task OnAnswerKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && Run.AwaitingAnswer && !string.IsNullOrWhiteSpace(Run.AnswerText))
        {
            await Run.SubmitAnswerAsync();
        }
    }
}
