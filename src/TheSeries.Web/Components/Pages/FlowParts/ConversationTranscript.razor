@* The conversation transcript: one block per completed turn (the user's message, the agent's reply
   or error, and a collapsible flow history rendered via FlowStepList). Hidden until a turn completes. *@

@if (Run.Turns.Count > 0)
{
    <section class="transcript">
        <h2>Conversation <span class="count">@Run.Turns.Count message@(Run.Turns.Count == 1 ? "" : "s")</span></h2>
        <div class="turns">
            @* Newest turn first, so the latest exchange sits next to the live flow above. *@
            @foreach (var turn in Run.Turns.Reverse())
            {
                var visibleTurnEvents = View.VisibleEvents(turn.Events);
                var turnCount = turn.Events.Select(e => e.Turn).DefaultIfEmpty(0).Max();
                <div class="turn" @key="turn">
                    <div class="bubble user">
                        <span class="who">🧑 You</span>
                        <p>@turn.Message</p>
                    </div>
                    <div class="bubble agent">
                        <span class="who">🤖 @(turn.Agent ?? "Agent")</span>
                        @if (!string.IsNullOrWhiteSpace(turn.Error))
                        {
                            <p class="error">@turn.Error</p>
                        }
                        else
                        {
                            <p>@turn.Reply</p>
                        }
                    </div>
                    @if (visibleTurnEvents.Count > 0)
                    {
                        <details class="turn-flow">
                            <summary>
                                Flow history <span class="progress">@visibleTurnEvents.Count step@(visibleTurnEvents.Count == 1 ? "" : "s")</span>
                                @if (turnCount > 0)
                                {
                                    <span class="turns-badge">· 🔁 @turnCount turn@(turnCount == 1 ? "" : "s")</span>
                                }
                            </summary>
                            <ol class="mini-steps">
                                <FlowStepList Events="visibleTurnEvents" Expandable="false" />
                            </ol>
                        </details>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;
}
