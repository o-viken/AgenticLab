@* The History tab of the left Controls panel: the past conversation turns (the user's message and the
   agent's reply or error for each completed turn). Read-only view over the run's archived turns; shows
   an empty-state until the first turn completes. Newest turn first, mirroring the bottom transcript. *@

<section class="controls history-controls">
    <div class="control">
        <label>Conversation history <span>@Run.Turns.Count turn@(Run.Turns.Count == 1 ? "" : "s")</span></label>

        @if (Run.Turns.Count == 0)
        {
            <p class="empty">No turns yet — send a message to start the conversation.</p>
        }
        else
        {
            <ol class="history-list">
                @{ var index = Run.Turns.Count; }
                @foreach (var turn in Run.Turns.Reverse())
                {
                    var ordinal = index--;
                    <li class="history-turn" @key="turn">
                        <span class="history-ordinal">@ordinal</span>
                        <div class="history-bubbles">
                            <p class="history-user"><span class="who">🧑 You</span> @turn.Message</p>
                            @if (!string.IsNullOrWhiteSpace(turn.Error))
                            {
                                <p class="history-agent error"><span class="who">🤖 @(turn.Agent ?? "Agent")</span> @turn.Error</p>
                            }
                            else
                            {
                                <p class="history-agent"><span class="who">🤖 @(turn.Agent ?? "Agent")</span> @turn.Reply</p>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </div>
</section>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;
}
