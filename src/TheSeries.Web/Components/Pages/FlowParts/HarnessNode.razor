@* The compact merged Client + AiService (Harness/Application) node: its icon (brand logo or the
   Default emoji), label/subtitle, optional workspace path and environment badge, and — in Expert —
   the Tools box and (for skill-using agents) the Skills catalogue. *@

<div class="node harness @Run.NodeClass("harness")">
    <ConceptInfoButton Id="harness" Title="Learn about the harness" />
    <span class="icon">
        @if (View.Vendor == Vendor.Default)
        {
            @(View.Perspective == Perspective.Expert ? "🛠️" : "📦")
        }
        else
        {
            <VendorIcon Vendor="View.Vendor" />
        }
    </span>
    <span class="title">@View.HarnessLabel</span>
    <span class="subtitle">@View.HarnessSubtitle</span>
    @if (View.SelectedAgentRequiresWorkspace && !string.IsNullOrWhiteSpace(View.Workspace))
    {
        <span class="subtitle workspace-path" title="@View.Workspace">📁 @View.Workspace</span>
    }
    @if (View.ShowEnvironment)
    {
        <span class="env-badge @View.EnvBadgeClass" title="@View.HarnessEnvTitle">@View.HarnessEnvLabel</span>
    }
    <EnvironmentPanel />
    @if (View.Perspective == Perspective.Expert)
    {
        <div class="tools node-inner @Run.NodeClass("tools")">
            <ConceptInfoButton Id="tools" Title="Learn about tools" />
            <span class="title">Tools</span>
            <span class="subtitle">@View.SelectedAgentTools</span>
            @if (View.SelectedAgentToolNames.Count > 0)
            {
                <div class="tool-chips">
                    @foreach (var tool in View.SelectedAgentToolNames)
                    {
                        <span class="tool-chip @View.ToolRiskClass(tool) @(View.IsToolEnabled(tool) ? "" : "off")"
                              title="@View.ToolRiskTitle(tool)">
                            @tool
                        </span>
                    }
                </div>
            }
        </div>
        @if (View.SelectedAgentSupportsSkills)
        {
            <div class="skills node-inner">
                <ConceptInfoButton Id="skills" Title="Learn about skills" />
                <span class="title">Skills</span>
                @if (Run.KnownSkills.Count == 0)
                {
                    <span class="subtitle">@(string.IsNullOrWhiteSpace(View.Workspace) ? "set a workspace to list skills" : "no skills in this workspace")</span>
                }
                else
                {
                    <div class="skill-chips">
                        @foreach (var skill in Run.KnownSkills)
                        {
                            <span class="skill-chip @(Run.IsSkillLoaded(skill.Name) ? "loaded" : "")"
                                  title="@skill.Description">
                                @skill.Name
                            </span>
                        }
                    </div>
                }
            </div>
        }
        @if (View.SelectedAgentSupportsMcp)
        {
            <div class="mcp node-inner">
                <ConceptInfoButton Id="mcp" Title="Learn about MCP" />
                <span class="title">MCP servers</span>
                @if (Run.KnownMcp.Count == 0)
                {
                    <span class="subtitle">no MCP server connected</span>
                }
                else
                {
                    <div class="skill-chips">
                        @foreach (var tool in Run.KnownMcp)
                        {
                            <span class="skill-chip" title="@tool.Description">@tool.Name</span>
                        }
                    </div>
                }
            </div>
        }
        @if (View.SelectedAgentSupportsA2A)
        {
            <div class="a2a node-inner">
                <ConceptInfoButton Id="a2a" Title="Learn about A2A" />
                <span class="title">A2A agents</span>
                @if (Run.KnownA2A.Count == 0)
                {
                    <span class="subtitle">no A2A agent connected</span>
                }
                else
                {
                    <div class="skill-chips">
                        @foreach (var agent in Run.KnownA2A)
                        {
                            <span class="skill-chip" title="@agent.Description">@agent.Name</span>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;
}
