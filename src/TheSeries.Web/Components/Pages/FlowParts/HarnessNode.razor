@* The compact merged Client + AiService (Harness/Application) node: its icon (brand logo or the
   Default emoji), label/subtitle, optional workspace path and environment badge, and — in Expert —
   the Tools box and (for skill-using agents) the Skills catalogue. *@

<div class="node harness @Run.Focus.NodeClass("harness")">
    <ConceptInfoButton Id="harness" Title="Learn about the agent host" />
    <span class="icon">
        @if (View.Vendor == Vendor.Default)
        {
            <span class="diagram-icon icon-harness" aria-hidden="true"></span>
        }
        else
        {
            <VendorIcon Vendor="View.Vendor" />
        }
    </span>
    <span class="title">@View.Harness.Label</span>
    <span class="subtitle">@View.Harness.Subtitle</span>
    @if (View.Agent.RequiresWorkspace && !string.IsNullOrWhiteSpace(View.Workspace))
    {
        <span class="subtitle workspace-path" title="@View.Workspace">📁 @View.Workspace</span>
    }
    @if (View.Diagram.ShowEnvironment)
    {
        <span class="env-badge @View.Agent.EnvBadgeClass" title="@View.Agent.EnvTitle">@View.Agent.EnvLabel</span>
    }
    <EnvironmentPanel />
    @if (View.Perspective == Perspective.Expert)
    {
        <div class="tools node-inner @Run.Focus.NodeClass("tools")">
            <ConceptInfoButton Id="tools" Title="Learn about tools" />
            <span class="title">Tools</span>
            <span class="subtitle">@View.Agent.ToolsSummary</span>
            @if (View.Agent.ToolNames.Count > 0)
            {
                <div class="tool-chips">
                    @foreach (var tool in View.Agent.ToolNames)
                    {
                        <span class="tool-chip @View.Agent.ToolRiskClass(tool) @(View.Options.IsToolEnabled(tool) ? "" : "off")"
                              title="@ChipTitle(tool)">
                            @tool
                        </span>
                    }
                </div>
            }
        </div>
        @if (View.Agent.SupportsSkills)
        {
            <div class="skills node-inner">
                <ConceptInfoButton Id="skills" Title="Learn about skills" />
                <span class="title">Skills</span>
                @if (Run.Catalogs.KnownSkills.Count == 0)
                {
                    <span class="subtitle">@(string.IsNullOrWhiteSpace(View.Workspace) ? "set a workspace to list skills" : "no skills in this workspace")</span>
                }
                else
                {
                    <div class="skill-chips">
                        @foreach (var skill in Run.Catalogs.KnownSkills)
                        {
                            <span class="skill-chip @(Run.Catalogs.IsSkillLoaded(skill.Name) ? "loaded" : "")"
                                  title="@skill.Description">
                                @skill.Name
                            </span>
                        }
                    </div>
                }
            </div>
        }
        @if (View.Agent.SupportsMcp)
        {
            <div class="mcp node-inner">
                <ConceptInfoButton Id="mcp" Title="Learn about MCP" />
                <span class="title">MCP servers</span>
                @if (Run.Catalogs.KnownMcp.Count == 0)
                {
                    <span class="subtitle">no MCP server connected</span>
                }
                else
                {
                    <div class="skill-chips">
                        @foreach (var tool in Run.Catalogs.KnownMcp)
                        {
                            <span class="skill-chip" title="@tool.Description">@tool.Name</span>
                        }
                    </div>
                }
            </div>
        }
        @if (View.Agent.SupportsA2A)
        {
            <div class="a2a node-inner">
                <ConceptInfoButton Id="a2a" Title="Learn about A2A" />
                <span class="title">A2A agents</span>
                @if (Run.Catalogs.KnownA2A.Count == 0)
                {
                    <span class="subtitle">no A2A agent connected</span>
                }
                else
                {
                    <div class="skill-chips">
                        @foreach (var agent in Run.Catalogs.KnownA2A)
                        {
                            <span class="skill-chip" title="@agent.Description">@agent.Name</span>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;

    // The chip tooltip: the tool's risk explanation, plus (for a workspace agent) the declared token it
    // was mapped from, so it's visible that a VS Code-style token became this app's backend tool.
    private string ChipTitle(string tool)
    {
        var title = View.Agent.ToolRiskTitle(tool);
        var mappedFrom = View.Agent.ToolMappedFrom(tool);
        return mappedFrom is null ? title : $"{title} · mapped from {mappedFrom}";
    }
}
