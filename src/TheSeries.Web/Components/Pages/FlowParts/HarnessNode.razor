<div class="node harness @Run.Focus.NodeClass("harness")">
    <ConceptInfoButton Id="harness" Title="Learn about the agent host" />
    <span class="icon">
        @if (View.Vendor == Vendor.Default)
        {
            <span class="diagram-icon icon-harness" aria-hidden="true"></span>
        }
        else
        {
            <VendorIcon Vendor="View.Vendor" />
        }
    </span>
    <span class="title">@View.Harness.Label</span>
    <span class="subtitle">@View.Harness.Subtitle</span>
    @if (View.Agent.RequiresWorkspace && !string.IsNullOrWhiteSpace(View.Workspace))
    {
        <span class="subtitle workspace-path" title="@View.Workspace">📁 @View.Workspace</span>
    }
    @if (View.Diagram.ShowEnvironment)
    {
        <span class="env-badge @View.Agent.EnvBadgeClass" title="@View.Agent.EnvTitle">@View.Agent.EnvLabel</span>
    }
    <EnvironmentPanel />
    @if (View.Diagram.ShowTools)
    {
        <div class="tools node-inner @Run.Focus.NodeClass("tools")">
            <ConceptInfoButton Id="tools" Title="Learn about tools" />
            <span class="title">Tools</span>
            <span class="subtitle">@View.Agent.ToolsSummary</span>
            @if (View.Agent.ToolNames.Count > 0)
            {
                <div class="tool-chips">
                    @foreach (var tool in View.Agent.ToolNames)
                    {
                        <span class="tool-chip @View.Agent.ToolRiskClass(tool) @(View.Options.IsToolEnabled(tool) ? "" : "off")"
                              title="@ChipTitle(tool)">
                            @tool
                        </span>
                    }
                </div>
            }
        </div>
    }
    <HostCatalogues />
</div>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;

    // The chip tooltip: the tool's risk explanation, plus (for a workspace agent) the declared token it
    // was mapped from, so it's visible that a VS Code-style token became this app's backend tool.
    private string ChipTitle(string tool)
    {
        var title = View.Agent.ToolRiskTitle(tool);
        var mappedFrom = View.Agent.ToolMappedFrom(tool);
        return mappedFrom is null ? title : $"{title} · mapped from {mappedFrom}";
    }
}
