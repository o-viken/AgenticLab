@page "/"
@rendermode InteractiveServer
@inject AiServiceClient Ai
@implements IDisposable
@using System.Threading

<PageTitle>TheSeries — Flow</PageTitle>

<div class="flow-app">
    <header class="flow-header">
        <h1>Chatbot Application Flow</h1>
        <p>Watch data travel live from the user, through the client and harness, to the tools and the LLM — and back. Stepping pauses the <em>real</em> backend execution, so it stays in sync with the telemetry.</p>
    </header>

    <section class="controls">
        <div class="control message">
            <label for="message">Message</label>
            <input id="message" @bind="_message" @bind:event="oninput"
                   placeholder="Ask something, e.g. How tall is the Eiffel Tower in metres?"
                   disabled="@_running" @onkeydown="OnKeyDownAsync" />
        </div>

        <div class="control">
            <label for="agent">Agent</label>
            <select id="agent" @bind="_selectedAgent" disabled="@_running">
                @foreach (var agent in _agents)
                {
                    <option value="@agent.Name">@agent.Name</option>
                }
            </select>
        </div>

        <div class="control">
            <label for="delay">Auto step delay <span>@_stepDelayMs ms</span></label>
            <input id="delay" type="range" min="0" max="3000" step="50"
                   @bind="_stepDelayMs" @bind:event="oninput" @bind:after="OnDelayChangedAsync"
                   disabled="@(_mode == FlowMode.Manual)" />
        </div>

        <div class="control">
            <label>Stepping</label>
            <div class="mode-toggle">
                <button type="button" class="@(_mode == FlowMode.Auto ? "selected" : "")"
                        disabled="@_running" @onclick="@(() => _mode = FlowMode.Auto)">Auto</button>
                <button type="button" class="@(_mode == FlowMode.Manual ? "selected" : "")"
                        disabled="@_running" @onclick="@(() => _mode = FlowMode.Manual)">Manual</button>
            </div>
        </div>

        <div class="control actions">
            @if (!_running)
            {
                <button class="send" @onclick="SendAsync" disabled="@string.IsNullOrWhiteSpace(_message)">Send</button>
            }
            else if (_mode == FlowMode.Manual)
            {
                <button class="send" @onclick="NextAsync" disabled="@_awaitingStep">@(_awaitingStep ? "Waiting…" : "Next ▶")</button>
                <button class="stop" @onclick="StopAsync">Stop</button>
            }
            else
            {
                <button class="send" @onclick="TogglePauseAsync">@(_paused ? "Resume ▶" : "Pause ⏸")</button>
                <button class="stop" @onclick="StopAsync">Stop</button>
            }
        </div>
    </section>

    <section class="diagram">
        <div class="column left">
            <div class="node @NodeClass("user")">
                <span class="icon">🧑</span>
                <span class="title">User</span>
            </div>
            <div class="connector vertical @ArrowClass("user-client")"></div>
            <div class="node @NodeClass("client")">
                <span class="icon">💻</span>
                <span class="title">Client</span>
                <span class="subtitle">Blazor web app</span>
            </div>
        </div>

        <div class="connector horizontal @ArrowClass("client-harness")">
            <span class="flow-label">Input</span>
        </div>

        <div class="column center">
            <div class="node harness @NodeClass("harness")">
                <span class="icon">🛠️</span>
                <span class="title">Harness</span>
                <span class="subtitle">AiService · Agent</span>
                <div class="tools node-inner @NodeClass("tools")">
                    <span class="title">Tools</span>
                    <span class="subtitle">Wiki · Calculator</span>
                </div>
            </div>
        </div>

        <div class="connector horizontal loop @ArrowClass("harness-llm")">
            <span class="flow-label">Input + Prompt + Tools</span>
            <span class="flow-label back">Response</span>
        </div>

        <div class="column right">
            <div class="node llm @NodeClass("llm")">
                <span class="icon">🤖</span>
                <span class="title">LLM (MCP)</span>
                <span class="subtitle">Azure OpenAI</span>
            </div>
        </div>
    </section>

    <section class="output">
        <div class="log">
            <h2>Steps <span class="progress">@StepProgress</span></h2>
            @if (_events.Count == 0)
            {
                <p class="empty">
                    @(_running && _mode == FlowMode.Manual
                        ? "Click \u201cNext\u201d to run and reveal each step."
                        : "No steps yet. Send a message to begin.")
                </p>
            }
            else
            {
                <ol>
                    @foreach (var e in _events)
                    {
                        <li class="step @e.Kind">
                            <span class="kind">@e.Kind</span>
                            <span class="label">@e.Label</span>
                            @if (!string.IsNullOrWhiteSpace(e.Detail) && e.Kind != "final")
                            {
                                <span class="detail">@e.Detail</span>
                            }
                        </li>
                    }
                </ol>
            }
        </div>

        <div class="reply">
            <h2>Reply</h2>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="error">@_error</p>
            }
            else if (!string.IsNullOrWhiteSpace(_reply))
            {
                <p>@_reply</p>
            }
            else
            {
                <p class="empty">The agent's final answer will appear here.</p>
            }
        </div>
    </section>
</div>

@code {
    private enum FlowMode { Auto, Manual }

    private readonly List<AgentInfo> _agents = new();
    private readonly List<FlowEvent> _events = new();

    private string _message = string.Empty;
    private string? _selectedAgent;
    private int _stepDelayMs = 600;
    private FlowMode _mode = FlowMode.Auto;

    private string? _activeNode;
    private string? _activeArrow;
    private string _reply = string.Empty;
    private string? _error;

    private bool _running;
    private bool _paused;
    private bool _awaitingStep;

    private string _sessionId = string.Empty;
    private CancellationTokenSource? _cts;

    private string StepProgress =>
        _events.Count == 0 ? string.Empty : $"{_events.Count} step{(_events.Count == 1 ? "" : "s")}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Ai.GetAgentsAsync();
            if (response is not null)
            {
                _agents.AddRange(response.Agents);
                _selectedAgent = response.Default;
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not load agents: {ex.Message}";
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !_running && !string.IsNullOrWhiteSpace(_message))
        {
            await SendAsync();
        }
    }

    private Task SendAsync()
    {
        if (_running || string.IsNullOrWhiteSpace(_message))
        {
            return Task.CompletedTask;
        }

        _running = true;
        _paused = false;
        _awaitingStep = false;
        _error = null;
        _reply = string.Empty;
        _activeNode = null;
        _activeArrow = null;
        _events.Clear();
        _sessionId = Guid.NewGuid().ToString("n");
        _cts = new CancellationTokenSource();

        // The backend paces the run; we render each step as it arrives and drive pace via control calls.
        _ = ConsumeAsync(_cts.Token);
        return Task.CompletedTask;
    }

    private async Task ConsumeAsync(CancellationToken token)
    {
        try
        {
            await foreach (var flowEvent in Ai.StreamFlowAsync(_message, _selectedAgent, _sessionId, _mode == FlowMode.Manual, _stepDelayMs, token))
            {
                _events.Add(flowEvent);
                (_activeNode, _activeArrow) = MapTarget(flowEvent.Kind);
                _awaitingStep = false;

                if (flowEvent.Kind == "final")
                {
                    _reply = flowEvent.Detail ?? string.Empty;
                }
                else if (flowEvent.Kind == "error")
                {
                    _error = flowEvent.Detail ?? flowEvent.Label;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Stopped by the user; keep whatever has been shown so far.
        }
        catch (Exception ex)
        {
            _error ??= $"Error talking to the AI service: {ex.Message}";
        }
        finally
        {
            Finish();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task NextAsync()
    {
        if (!_running || _mode != FlowMode.Manual || _awaitingStep)
        {
            return;
        }

        _awaitingStep = true;
        StateHasChanged();
        await SafeControlAsync("next");
    }

    private async Task TogglePauseAsync()
    {
        if (!_running)
        {
            return;
        }

        _paused = !_paused;
        await SafeControlAsync(_paused ? "pause" : "resume");
    }

    private async Task OnDelayChangedAsync()
    {
        if (_running && _mode == FlowMode.Auto)
        {
            await SafeControlAsync(action: null, delayMs: _stepDelayMs);
        }
    }

    private async Task StopAsync()
    {
        _cts?.Cancel();
        await SafeControlAsync("stop");
    }

    private async Task SafeControlAsync(string? action, int? delayMs = null)
    {
        if (string.IsNullOrEmpty(_sessionId))
        {
            return;
        }

        try
        {
            await Ai.SendControlAsync(_sessionId, action, delayMs: delayMs);
        }
        catch
        {
            // Best-effort: control is advisory and the run may already have ended.
        }
    }

    private void Finish()
    {
        _running = false;
        _paused = false;
        _awaitingStep = false;
        _activeNode = null;
        _activeArrow = null;
    }

    private static (string? Node, string? Arrow) MapTarget(string kind) => kind switch
    {
        "received" => ("harness", "client-harness"),
        "llm-request" => ("llm", "harness-llm"),
        "tool-call" => ("tools", "harness-llm"),
        "tool-result" => ("harness", "harness-llm"),
        "llm-response" => ("llm", "harness-llm"),
        "final" => ("client", "client-harness"),
        "error" => ("harness", null),
        _ => (null, null),
    };

    private string NodeClass(string node) => _activeNode == node ? "active" : string.Empty;

    private string ArrowClass(string arrow) => _activeArrow == arrow ? "active" : string.Empty;

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
