@page "/"
@rendermode InteractiveServer

<PageTitle>TheSeries — @_view.ThemeName</PageTitle>

<div class="flow-app @_view.ThemeClass @_view.PinnedClass">
    <header class="flow-header">
        <div class="flow-header-text">
            <h1>Agent Application Flow — @_view.ThemeName</h1>
            <p>Watch data travel live from the user, through the client and harness, to the tools and the LLM — and back. Stepping pauses the <em>real</em> backend execution, so it stays in sync with the telemetry.</p>
        </div>
        <div class="flow-header-actions">
            <div class="mode-toggle layout-toggle" title="Choose how the controls and the flow are arranged">
                <button type="button" class="@(_view.Layout == FlowLayout.Stacked ? "selected" : "")"
                        @onclick="@(() => SetLayoutAsync(FlowLayout.Stacked))" title="Controls above the flow">Stacked</button>
                <button type="button" class="@(_view.Layout == FlowLayout.Split ? "selected" : "")"
                        @onclick="@(() => SetLayoutAsync(FlowLayout.Split))" title="Controls beside the flow">Side by side</button>
            </div>
            <label class="check concept-toggle" title="Show or hide all the learning info across the page">
                <input type="checkbox" @bind="_view.ShowConcepts" /> Show concept info
            </label>
        </div>
    </header>

    <CascadingValue Value="_view">
        <CascadingValue Value="_run">
            <div class="flow-body @_view.LayoutClass">
                <div class="flow-controls-col">
                    <FlowControls OnSelectTheme="SetThemeAsync" />
                </div>
                <div class="flow-main-col">
                    <FlowDiagram />
                    <ConversationTranscript />
                    <FlowOutput />
                </div>
            </div>
        </CascadingValue>
    </CascadingValue>

    <ConceptDrawer Concept="_view.ActiveConcept" Pinned="_view.ConceptPinned"
                   OnClose="_view.CloseConcept" OnTogglePin="_view.ToggleConceptPin" />
</div>
