@page "/"
@rendermode InteractiveServer
@inject AiServiceClient Ai
@implements IDisposable
@using System.Threading
@using System.Text.Json

<PageTitle>TheSeries — Flow</PageTitle>

<div class="flow-app">
    <header class="flow-header">
        <h1>Agent Application Flow</h1>
        <p>Watch data travel live from the user, through the client and harness, to the tools and the LLM — and back. Stepping pauses the <em>real</em> backend execution, so it stays in sync with the telemetry.</p>
    </header>

    <section class="controls">
        <div class="control message">
            <label for="message">Message</label>
            <input id="message" @bind="_message" @bind:event="oninput"
                   placeholder="Ask something, e.g. How tall is the Eiffel Tower in metres?"
                   disabled="@_running" @onkeydown="OnKeyDownAsync" />
        </div>

        <div class="control">
            <label for="agent">Agent</label>
            <select id="agent" @bind="SelectedAgent" @bind:after="RefreshKnownSkillsAsync" disabled="@_running">
                @foreach (var agent in _agents)
                {
                    <option value="@agent.Name">@agent.Name</option>
                }
            </select>
        </div>

        @if (SelectedAgentToolNames.Count > 0)
        {
            <div class="control">
                <label>Tools</label>
                <div class="tool-toggles">
                    @foreach (var tool in SelectedAgentToolNames)
                    {
                        <label class="check">
                            <input type="checkbox" checked="@IsToolEnabled(tool)" disabled="@_running"
                                   @onchange="@(e => SetToolEnabled(tool, (bool)e.Value!))" />
                            @tool
                        </label>
                    }
                </div>
            </div>
        }

        @if (SelectedAgentRequiresWorkspace)
        {
            <div class="control message">
                <label for="workspace">Workspace</label>
                <input id="workspace" @bind="_workspace" @bind:event="oninput" @onblur="RefreshKnownSkillsAsync"
                       placeholder="Absolute path to a folder the agent may edit, e.g. C:\code\my-app"
                       disabled="@_running" />
            </div>
        }

        <div class="control">
            <label for="delay">Auto step delay <span>@_stepDelayMs ms</span></label>
            <input id="delay" type="range" min="0" max="3000" step="50"
                   @bind="_stepDelayMs" @bind:event="oninput" @bind:after="OnDelayChangedAsync"
                   disabled="@(_mode == FlowMode.Manual)" />
        </div>

        <div class="control">
            <label>Stepping</label>
            <div class="mode-toggle">
                <button type="button" class="@(_mode == FlowMode.Auto ? "selected" : "")"
                        disabled="@_running" @onclick="@(() => _mode = FlowMode.Auto)">Auto</button>
                <button type="button" class="@(_mode == FlowMode.Manual ? "selected" : "")"
                        disabled="@_running" @onclick="@(() => _mode = FlowMode.Manual)">Manual</button>
            </div>
        </div>

        <div class="control">
            <label>Perspective</label>
            <div class="mode-toggle perspective-toggle">
                <button type="button" class="@(_perspective == Perspective.NonTechnical ? "selected" : "")"
                        @onclick="@(() => _perspective = Perspective.NonTechnical)"
                        title="User → Application → LLM">Non-technical</button>
                <button type="button" class="@(_perspective == Perspective.Technical ? "selected" : "")"
                        @onclick="@(() => _perspective = Perspective.Technical)"
                        title="User → Client → AiService → LLM">Technical</button>
                <button type="button" class="@(_perspective == Perspective.Expert ? "selected" : "")"
                        @onclick="@(() => _perspective = Perspective.Expert)"
                        title="Full harness, tools and steps">Expert</button>
            </div>
        </div>

        @if (_perspective == Perspective.Expert)
        {
            <div class="control">
                <label>Boundaries</label>
                <div class="boundary-toggles">
                    <label class="check"><input type="checkbox" @bind="_showHarnessBoundary" /> Harness</label>
                    <label class="check"><input type="checkbox" @bind="_showAgentBoundary" /> Agent</label>
                    <label class="check"><input type="checkbox" @bind="_expandHarness" /> Expand harness</label>
                </div>
            </div>
        }

        <div class="control actions">
            @if (!_running)
            {
                <button class="send" @onclick="SendAsync" disabled="@(string.IsNullOrWhiteSpace(_message) || (SelectedAgentRequiresWorkspace && string.IsNullOrWhiteSpace(_workspace)))">Send</button>
                <button class="stop" @onclick="NewConversationAsync" title="Forget the conversation history and start fresh.">New conversation</button>
            }
            else if (_mode == FlowMode.Manual)
            {
                <button class="send" @onclick="NextAsync" disabled="@_awaitingStep">@(_awaitingStep ? "Waiting…" : "Next ▶")</button>
                <button class="stop" @onclick="StopAsync">Stop</button>
            }
            else
            {
                <button class="send" @onclick="TogglePauseAsync">@(_paused ? "Resume ▶" : "Pause ⏸")</button>
                <button class="stop" @onclick="StopAsync">Stop</button>
            }
        </div>
    </section>

    <section class="diagram @PerspectiveClass">
        @if (_perspective == Perspective.Expert && _showHarnessBoundary)
        {
            <div class="boundary harness-b">
                <span class="boundary-label">Harness</span>
            </div>
        }
        @if (_perspective == Perspective.Expert && _showAgentBoundary)
        {
            <div class="boundary agent-b">
                <span class="boundary-label">Agent</span>
            </div>
        }

        <div class="node user @NodeClass("user")">
            <span class="icon">🧑</span>
            <span class="title">User</span>
            <span class="subtitle">Human</span>
        </div>

        <div class="connector-group user-node">
            <div class="connector horizontal send @ArrowClass("user-node-send")">
                <span class="flow-label">Input ▶</span>
            </div>
            <div class="connector horizontal recv @ArrowClass("user-node-recv")">
                <span class="flow-label">◀ Reply</span>
            </div>
        </div>

        <div class="column center">
            @if (_perspective == Perspective.Expert && _expandHarness)
            {
                <div class="node harness anatomy @NodeClass("harness")">
                    <span class="anatomy-heading">Harness anatomy</span>

                    <div class="layer app">
                        <span class="layer-title">System Prompt</span>
                        <span class="layer-body">Global harness prompt — operating rules + tool loop (expert coding assistant++)</span>
                        <span class="set-by">Set by application</span>
                    </div>

                    <div class="layer app">
                        <span class="layer-title">Client</span>
                        <span class="layer-body">Blazor web app · sends the prompt, renders the reply</span>
                        <span class="set-by">Set by application</span>
                    </div>

                    <div class="layer agent">
                        <span class="layer-title">Agent Persona</span>
                        <span class="layer-body">@_selectedAgent — @SelectedAgentDescription</span>
                        <span class="set-by">Set per agent</span>
                    </div>

                    <div class="layer agent tools @NodeClass("tools")">
                        <span class="layer-title">Tools / MCP</span>
                        @if (SelectedAgentToolNames.Count == 0)
                        {
                            <span class="layer-body">none</span>
                        }
                        else
                        {
                            <ul class="tool-checks">
                                @foreach (var tool in SelectedAgentToolNames)
                                {
                                    <li>@(IsToolEnabled(tool) ? "[x]" : "[ ]") @tool</li>
                                }
                            </ul>
                        }
                        <span class="set-by">Set per agent</span>
                    </div>

                    <div class="layer agent">
                        <span class="layer-title">Settings</span>
                        <span class="layer-body">model: Azure OpenAI · stepping: @_mode</span>
                        <span class="set-by">Set per agent</span>
                    </div>

                    <div class="layer user">
                        <span class="layer-title">User prompt</span>
                        <span class="layer-body">@CurrentUserPrompt</span>
                        <span class="set-by">Set by user</span>
                    </div>

                    <div class="context-stack">
                        <div class="context-head">
                            <span class="context-title">Context</span>
                            <span class="context-meta">@ContentEvents.Count content entr@(ContentEvents.Count == 1 ? "y" : "ies") · ~@(ContextSize) chars</span>
                        </div>
                        <div class="context-bar"><span style="width:@(ContextBarWidth)%"></span></div>
                        @if (ContentEvents.Count == 0)
                        {
                            <span class="context-empty">content grows as the agent runs…</span>
                        }
                        else
                        {
                            <ol class="context-chips">
                                @foreach (var e in ContentEvents)
                                {
                                    var chip = ContextChip(e);
                                    var preview = ContextPreview(e);
                                    <li class="ctx @chip.Source">
                                        <div class="ctx-row">
                                            @if (e.Turn > 0)
                                            {
                                                <span class="ctx-turn">T@(e.Turn)</span>
                                            }
                                            <span class="ctx-label">@chip.Label</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(preview))
                                        {
                                            <span class="ctx-preview">@preview</span>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="node harness @NodeClass("harness")">
                    <span class="icon">@(_perspective == Perspective.Expert ? "🛠️" : "📦")</span>
                    <span class="title">@(_perspective == Perspective.Expert ? "Harness" : "Application")</span>
                    <span class="subtitle">@HarnessSubtitle</span>
                    @if (SelectedAgentRequiresWorkspace && !string.IsNullOrWhiteSpace(_workspace))
                    {
                        <span class="subtitle workspace-path" title="@_workspace">📁 @_workspace</span>
                    }
                    @if (_perspective == Perspective.Expert)
                    {
                        <div class="tools node-inner @NodeClass("tools")">
                            <span class="title">Tools</span>
                            <span class="subtitle">@SelectedAgentTools</span>
                        </div>
                        @if (SelectedAgentSupportsSkills)
                        {
                            <div class="skills node-inner">
                                <span class="title">Skills</span>
                                @if (_knownSkills.Count == 0)
                                {
                                    <span class="subtitle">@(string.IsNullOrWhiteSpace(_workspace) ? "set a workspace to list skills" : "no skills in this workspace")</span>
                                }
                                else
                                {
                                    <div class="skill-chips">
                                        @foreach (var skill in _knownSkills)
                                        {
                                            <span class="skill-chip @(_loadedSkills.Contains(skill.Name) ? "loaded" : "")"
                                                  title="@skill.Description">
                                                @skill.Name
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }

            @if (_perspective == Perspective.Expert && ActiveResourceInfo is { } resource)
            {
                <div class="connector vertical active"></div>
                <div class="resources">
                    <div class="node resource active">
                        <span class="icon">@resource.Icon</span>
                        <span class="title">@resource.Title</span>
                        <span class="subtitle">@resource.Transport</span>
                    </div>
                </div>
            }
        </div>

        <div class="connector-group loop">
            @if (_perspective != Perspective.NonTechnical)
            {
                <div class="loop-badge @(_running && CurrentTurn > 0 ? "active" : "")">
                    <span class="loop-icon">🔁</span>
                    <span class="loop-count">@LoopLabel</span>
                </div>
            }
            <div class="connector horizontal send @ArrowClass("node-llm-send")">
                <span class="flow-label">Prompt + Tools ▶</span>
            </div>
            <div class="connector horizontal recv @ArrowClass("node-llm-recv")">
                <span class="flow-label">◀ Response</span>
                @if (_activeArrow == "node-llm-recv" && !string.IsNullOrEmpty(_responseHint))
                {
                    <span class="response-hint">@_responseHint</span>
                }
            </div>
        </div>

        <div class="column right">
            <div class="node llm @NodeClass("llm")">
                <span class="icon">🤖</span>
                <span class="title">LLM</span>
                <span class="subtitle">Azure OpenAI</span>
            </div>
        </div>
    </section>

    @if (_turns.Count > 0)
    {
        <section class="transcript">
            <h2>Conversation <span class="count">@_turns.Count message@(_turns.Count == 1 ? "" : "s")</span></h2>
            <div class="turns">
                @foreach (var turn in _turns)
                {
                    var visibleTurnEvents = VisibleEvents(turn.Events);
                    var turnCount = turn.Events.Select(e => e.Turn).DefaultIfEmpty(0).Max();
                    <div class="turn">
                        <div class="bubble user">
                            <span class="who">🧑 You</span>
                            <p>@turn.Message</p>
                        </div>
                        <div class="bubble agent">
                            <span class="who">🤖 @(turn.Agent ?? "Agent")</span>
                            @if (!string.IsNullOrWhiteSpace(turn.Error))
                            {
                                <p class="error">@turn.Error</p>
                            }
                            else
                            {
                                <p>@turn.Reply</p>
                            }
                        </div>
                        @if (visibleTurnEvents.Count > 0)
                        {
                            <details class="turn-flow">
                                <summary>
                                    Flow history <span class="progress">@visibleTurnEvents.Count step@(visibleTurnEvents.Count == 1 ? "" : "s")</span>
                                    @if (turnCount > 0)
                                    {
                                        <span class="turns-badge">· 🔁 @turnCount turn@(turnCount == 1 ? "" : "s")</span>
                                    }
                                </summary>
                                <ol class="mini-steps">
                                    @foreach (var e in visibleTurnEvents)
                                    {
                                        var hasData = !string.IsNullOrWhiteSpace(e.Data);
                                        <li class="step @e.Kind">
                                            <div class="step-row">
                                                <span class="kind">@e.Kind</span>
                                                @if (e.Turn > 0)
                                                {
                                                    <span class="turn-badge">T@e.Turn</span>
                                                }
                                                <span class="label">@e.Label</span>
                                                @if (!string.IsNullOrWhiteSpace(e.Detail) && e.Kind != "final")
                                                {
                                                    <span class="detail">@e.Detail</span>
                                                }
                                            </div>
                                            @if (hasData)
                                            {
                                                <details class="step-data-wrap">
                                                    <summary>data</summary>
                                                    <pre class="step-data">@e.Data</pre>
                                                </details>
                                            }
                                        </li>
                                    }
                                </ol>
                            </details>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <section class="output">
        <div class="log">
            <h2>
                Steps <span class="progress">@StepProgress</span>
                @if (TotalTurns > 0)
                {
                    <span class="turns">· 🔁 @TotalTurns turn@(TotalTurns == 1 ? "" : "s")</span>
                }
            </h2>
            @if (VisibleStepCount == 0)
            {
                <p class="empty">
                    @(_running && _mode == FlowMode.Manual
                        ? "Click \u201cNext\u201d to run and reveal each step."
                        : "No steps yet. Send a message to begin.")
                </p>
            }
            else
            {
                <ol>
                    @foreach (var e in VisibleEvents(_events))
                    {
                        var hasData = !string.IsNullOrWhiteSpace(e.Data);
                        var expanded = _expanded.Contains(e.Sequence);
                        <li class="step @e.Kind @(hasData ? "expandable" : "") @(expanded ? "expanded" : "")">
                            <div class="step-row" @onclick="@(() => ToggleStep(e.Sequence))">
                                <span class="kind">@e.Kind</span>
                                @if (e.Turn > 0)
                                {
                                    <span class="turn-badge">T@e.Turn</span>
                                }
                                <span class="label">@e.Label</span>
                                @if (hasData)
                                {
                                    <span class="expand-icon">@(expanded ? "▾" : "▸")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(e.Detail) && e.Kind != "final")
                                {
                                    <span class="detail">@e.Detail</span>
                                }
                            </div>
                            @if (hasData && expanded)
                            {
                                <pre class="step-data">@e.Data</pre>
                            }
                        </li>
                    }
                </ol>
            }
        </div>

        <div class="reply">
            <h2>Reply</h2>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="error">@_error</p>
            }
            else if (!string.IsNullOrWhiteSpace(_reply))
            {
                <p>@_reply</p>
            }
            else
            {
                <p class="empty">The agent's final answer will appear here.</p>
            }
        </div>
    </section>
</div>

@code {
    private enum FlowMode { Auto, Manual }

    // The level of detail shown in the diagram and Steps list.
    //   NonTechnical: User → Application → LLM (Client + AiService merged, no tools/loop).
    //   Technical:    User → Client → AiService → LLM (no nested Tools box / resources).
    //   Expert:       the complete harness view (Tools, resources, loop badge, every step).
    private enum Perspective { NonTechnical, Technical, Expert }

    private readonly List<AgentInfo> _agents = new();
    private readonly List<FlowEvent> _events = new();
    private readonly HashSet<int> _expanded = new();

    // The conversation transcript: each completed turn keeps its message, reply and full flow history.
    private readonly List<ConversationTurn> _turns = new();
    // The message/agent of the run currently shown in the live panels, archived into _turns on the next send.
    private string _runMessage = string.Empty;
    private string? _runAgent;

    private string _message = string.Empty;
    private string? _selectedAgent;
    private string _workspace = string.Empty;
    // The names of the selected agent's tools the user has switched off for the next run.
    private readonly HashSet<string> _disabledTools = new(StringComparer.OrdinalIgnoreCase);
    // The skills discovered in the workspace for this run (parsed from the streamed llm-request).
    private readonly List<SkillChip> _knownSkills = new();
    // The skills whose full instructions the model has loaded via ReadSkill during this run.
    private readonly HashSet<string> _loadedSkills = new(StringComparer.OrdinalIgnoreCase);
    private int _stepDelayMs = 600;
    private FlowMode _mode = FlowMode.Auto;

    private bool _showHarnessBoundary = false;
    private bool _showAgentBoundary = false;

    // The currently selected detail level for the diagram and Steps list (defaults to the expert view).
    private Perspective _perspective = Perspective.Expert;
    // Whether the Harness node is expanded into its "anatomy" (system prompt, persona, tools, settings,
    // user prompt) — only offered in the Expert perspective.
    private bool _expandHarness = false;

    private string? _activeNode;
    private string? _activeArrow;
    private string? _activeTool;
    // A short hint shown on the LLM receive arrow describing the latest response type (e.g. function call, text).
    private string? _responseHint;
    private string _reply = string.Empty;
    private string? _error;

    private bool _running;
    private bool _paused;
    private bool _awaitingStep;

    private string _sessionId = string.Empty;
    // Stays the same across sends so the agent remembers prior turns; reset by "New conversation".
    private string _conversationId = Guid.NewGuid().ToString("n");
    private CancellationTokenSource? _cts;

    // The CSS class applied to the diagram so the grid layout matches the selected perspective.
    private string PerspectiveClass => _perspective switch
    {
        Perspective.NonTechnical => "p-nontech",
        Perspective.Technical => "p-mid",
        _ => "p-full",
    };

    // Filters a flow's events down to those the current perspective shows:
    //   Expert shows everything; Technical hides the tool-call/result detail; NonTechnical keeps only the
    //   message in and the final answer out (plus errors).
    private IReadOnlyList<FlowEvent> VisibleEvents(IEnumerable<FlowEvent> events) => _perspective switch
    {
        Perspective.NonTechnical => events.Where(e => e.Kind is "received" or "final" or "error").ToList(),
        Perspective.Technical => events.Where(e => e.Kind is not "tool-call" and not "tool-result").ToList(),
        _ => events as IReadOnlyList<FlowEvent> ?? events.ToList(),
    };

    private int VisibleStepCount => VisibleEvents(_events).Count;

    private string StepProgress =>
        VisibleStepCount == 0 ? string.Empty : $"{VisibleStepCount} step{(VisibleStepCount == 1 ? "" : "s")}";

    // The LLM round-trip of the most recent step (0 before the first request).
    private int CurrentTurn => _events.Count == 0 ? 0 : _events[^1].Turn;

    // The total number of LLM round-trips seen so far.
    private int TotalTurns => _events.Select(e => e.Turn).DefaultIfEmpty(0).Max();

    // A compact label for the loop badge: the live turn while running, or the total when finished.
    private string LoopLabel =>
        _running
            ? (CurrentTurn == 0 ? "Turn …" : $"Turn {CurrentTurn}")
            : (TotalTurns == 0 ? "—" : $"{TotalTurns} turn{(TotalTurns == 1 ? "" : "s")}");

    // Whether the currently selected agent requires a workspace path before it can run.
    private bool SelectedAgentRequiresWorkspace =>
        _agents.FirstOrDefault(a => a.Name == _selectedAgent)?.RequiresWorkspace ?? false;

    // Whether the currently selected agent uses workspace skills, so the harness Skills box is shown.
    private bool SelectedAgentSupportsSkills =>
        _agents.FirstOrDefault(a => a.Name == _selectedAgent)?.SupportsSkills ?? false;

    // The tools available to the currently selected agent, shown in the harness Tools box.
    private string SelectedAgentTools
    {
        get
        {
            var tools = _agents.FirstOrDefault(a => a.Name == _selectedAgent)?.Tools;
            return tools is { Count: > 0 } ? string.Join(" · ", tools) : "—";
        }
    }
    // The full tool list of the selected agent, used to render the per-tool on/off checkboxes.
    private IReadOnlyList<string> SelectedAgentToolNames =>
        _agents.FirstOrDefault(a => a.Name == _selectedAgent)?.Tools ?? Array.Empty<string>();

    // The selected agent's persona/description, shown in the harness anatomy view.
    private string SelectedAgentDescription =>
        _agents.FirstOrDefault(a => a.Name == _selectedAgent)?.Description ?? "—";

    // The subtitle of the merged Client + AiService node. Non-technical states the grouping plainly;
    // Technical/Expert name the agent running inside it.
    private string HarnessSubtitle => _perspective switch
    {
        Perspective.NonTechnical => "Client + AiService",
        Perspective.Technical => $"Client + AiService · {_selectedAgent ?? "Agent"}",
        _ => $"AiService · {_selectedAgent ?? "Agent"}",
    };

    // The user's prompt for the current/next run, shown as the "Set by user" anatomy layer.
    private string CurrentUserPrompt =>
        !string.IsNullOrWhiteSpace(_runMessage) ? _runMessage
        : !string.IsNullOrWhiteSpace(_message) ? _message
        : "—";

    // A rough measure of how much context the model is carrying, summed from the captured step data.
    // Drives the growing "context" bar so adding a turn visibly grows the context.
    private int ContextSize => _events.Sum(e => (e.Data?.Length ?? 0) + e.Label.Length);

    // The width (0–100%) of the context growth bar, scaled so typical runs fill it gradually.
    private int ContextBarWidth => Math.Min(100, ContextSize / 80);

    // The subset of events that carry actual conversation content (user/tool/assistant text). The
    // structural pieces — the system prompt, the tool catalogue and the persona — are deliberately
    // excluded here because they are already shown in the coloured anatomy boxes above; the Context
    // stack focuses on the content that flows through the model turn by turn.
    private IReadOnlyList<FlowEvent> ContentEvents =>
        _events.Where(IsContentEvent).ToList();

    // True for events whose payload is conversation content rather than structural scaffolding.
    // Excludes "llm-request" (system prompt + tool schemas) and "tool-call" (the model's tool request,
    // an agent action) — both are represented by the coloured boxes.
    private static bool IsContentEvent(FlowEvent e) => e.Kind switch
    {
        "received" or "tool-result" or "llm-response" or "final" or "error" => true,
        _ => false,
    };

    // A short, single-line preview of the actual content an event contributed, so the Context stack
    // shows what flowed into the model — not just its category. Falls back to the detail/label.
    private static string ContextPreview(FlowEvent e)
    {
        var text = !string.IsNullOrWhiteSpace(e.Data) ? e.Data
            : !string.IsNullOrWhiteSpace(e.Detail) ? e.Detail
            : string.Empty;

        text = System.Text.RegularExpressions.Regex.Replace(text, "\\s+", " ").Trim();
        return text.Length > 90 ? text[..90] + "…" : text;
    }

    // Maps a flow event to a short context chip (what got appended to the model's context) and the
    // party that contributed it: "app" (application/harness), "agent" (the model/persona) or "user".
    private static (string Label, string Source) ContextChip(FlowEvent e) => e.Kind switch
    {
        "received" => ("User message", "user"),
        "llm-request" => ("System prompt + tools", "app"),
        "tool-call" => ("Assistant: tool call", "agent"),
        "tool-result" => ("Tool result", "app"),
        "llm-response" => ("Assistant message", "agent"),
        "final" => ("Final answer", "user"),
        "error" => ("Error", "app"),
        _ => (e.Kind, "app"),
    };

    // The selected agent, switching it resets which tools are disabled (the names are agent-specific).
    private string? SelectedAgent
    {
        get => _selectedAgent;
        set
        {
            if (_selectedAgent == value)
            {
                return;
            }

            _selectedAgent = value;
            _disabledTools.Clear();
            _knownSkills.Clear();
            _loadedSkills.Clear();
        }
    }

    // Whether the given tool is currently enabled (offered to the model) for the next run.
    private bool IsToolEnabled(string tool) => !_disabledTools.Contains(tool);

    // Switches a tool on or off for the next run.
    private void SetToolEnabled(string tool, bool enabled)
    {
        if (enabled)
        {
            _disabledTools.Remove(tool);
        }
        else
        {
            _disabledTools.Add(tool);
        }
    }
    // Describes an external resource a tool reaches out to, shown as a node below the harness.
    private sealed record ResourceInfo(string Key, string Icon, string Title, string Transport, string[] ToolNames);

    // The external resources the tools can reach. Each maps one or more tool names to a transport.
    private static readonly ResourceInfo[] KnownResources =
    {
        new("wikipedia", "🌐", "Wikipedia", "HTTPS · en.wikipedia.org", new[] { "SearchWiki", "GetWikiPage" }),
        new("compute", "🧮", "Local compute", "In-process · CPU", new[] { "Calculate" }),
        new("workspace", "📁", "Workspace", "Local file system", new[] { "ReadFile", "ListFiles", "WriteFile", "DeleteFile" }),
        new("shell", "⌨️", "Terminal", "Local process · allowlisted", new[] { "RunCommand" }),
        new("skills", "📚", "Skills", "Local · workspace SKILL.md", new[] { "ReadSkill" }),
    };

    // The resource currently being used, based on the active tool, or null when none is active.
    // Resources are only shown while their tool runs — never before or after.
    private ResourceInfo? ActiveResourceInfo =>
        _activeTool is null ? null : KnownResources.FirstOrDefault(r => r.ToolNames.Contains(_activeTool));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Ai.GetAgentsAsync();
            if (response is not null)
            {
                _agents.AddRange(response.Agents);
                _selectedAgent = response.Default;
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not load agents: {ex.Message}";
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !_running && !string.IsNullOrWhiteSpace(_message))
        {
            await SendAsync();
        }
    }

    private Task SendAsync()
    {
        if (_running || string.IsNullOrWhiteSpace(_message))
        {
            return Task.CompletedTask;
        }

        _running = true;
        _paused = false;
        _awaitingStep = false;
        _error = null;
        _reply = string.Empty;
        _activeNode = null;
        _activeArrow = null;
        _activeTool = null;
        _responseHint = null;
        ArchiveCurrentRun();
        _runMessage = _message;
        _runAgent = _selectedAgent;
        _events.Clear();
        _expanded.Clear();
        _loadedSkills.Clear();
        _sessionId = Guid.NewGuid().ToString("n");
        _cts = new CancellationTokenSource();

        // The backend paces the run; we render each step as it arrives and drive pace via control calls.
        _ = ConsumeAsync(_cts.Token);
        return Task.CompletedTask;
    }

    // Forgets the conversation's history on the server and starts a fresh one, clearing the panel.
    private async Task NewConversationAsync()
    {
        if (_running)
        {
            return;
        }

        var previous = _conversationId;
        _conversationId = Guid.NewGuid().ToString("n");
        _reply = string.Empty;
        _error = null;
        _activeNode = null;
        _activeArrow = null;
        _activeTool = null;
        _responseHint = null;
        _events.Clear();
        _expanded.Clear();
        _turns.Clear();
        _loadedSkills.Clear();
        _runMessage = string.Empty;
        _runAgent = null;

        try
        {
            await Ai.ResetConversationAsync(previous);
        }
        catch (Exception ex)
        {
            _error = $"Could not reset the conversation: {ex.Message}";
        }
    }

    // Moves the run currently in the live panels into the conversation transcript, preserving its history.
    private void ArchiveCurrentRun()
    {
        if (_events.Count == 0)
        {
            return;
        }

        _turns.Add(new ConversationTurn(
            _runMessage,
            _runAgent,
            _reply,
            _error,
            new List<FlowEvent>(_events)));
    }

    private async Task ConsumeAsync(CancellationToken token)
    {
        try
        {
            await foreach (var flowEvent in Ai.StreamFlowAsync(_message, _selectedAgent, _sessionId, _conversationId, _mode == FlowMode.Manual, _stepDelayMs, _workspace, _disabledTools.Count > 0 ? _disabledTools.ToArray() : null, token))
            {
                _events.Add(flowEvent);
                (_activeNode, _activeArrow) = MapTarget(flowEvent.Kind);
                _activeTool = ToolNameFor(flowEvent);
                _responseHint = ResponseHintFor(flowEvent) ?? _responseHint;
                _awaitingStep = false;

                TrackSkills(flowEvent);

                if (flowEvent.Kind == "final")
                {
                    _reply = flowEvent.Detail ?? string.Empty;
                }
                else if (flowEvent.Kind == "error")
                {
                    _error = flowEvent.Detail ?? flowEvent.Label;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Stopped by the user; keep whatever has been shown so far.
        }
        catch (Exception ex)
        {
            _error ??= $"Error talking to the AI service: {ex.Message}";
        }
        finally
        {
            Finish();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task NextAsync()
    {
        if (!_running || _mode != FlowMode.Manual || _awaitingStep)
        {
            return;
        }

        _awaitingStep = true;
        StateHasChanged();
        await SafeControlAsync("next");
    }

    private async Task TogglePauseAsync()
    {
        if (!_running)
        {
            return;
        }

        _paused = !_paused;
        await SafeControlAsync(_paused ? "pause" : "resume");
    }

    private async Task OnDelayChangedAsync()
    {
        if (_running && _mode == FlowMode.Auto)
        {
            await SafeControlAsync(action: null, delayMs: _stepDelayMs);
        }
    }

    private async Task StopAsync()
    {
        _cts?.Cancel();
        await SafeControlAsync("stop");
    }

    private async Task SafeControlAsync(string? action, int? delayMs = null)
    {
        if (string.IsNullOrEmpty(_sessionId))
        {
            return;
        }

        try
        {
            await Ai.SendControlAsync(_sessionId, action, delayMs: delayMs);
        }
        catch
        {
            // Best-effort: control is advisory and the run may already have ended.
        }
    }

    private void Finish()
    {
        _running = false;
        _paused = false;
        _awaitingStep = false;
        _activeNode = null;
        _activeArrow = null;
        _activeTool = null;
        _responseHint = null;
    }

    private static (string? Node, string? Arrow) MapTarget(string kind) => kind switch
    {
        "received" => ("harness", "user-node-send"),
        "llm-request" => ("llm", "node-llm-send"),
        "tool-call" => ("tools", "node-llm-recv"),
        "tool-result" => ("harness", "node-llm-recv"),
        "llm-response" => ("harness", "node-llm-recv"),
        "final" => ("harness", "user-node-recv"),
        "error" => ("harness", null),
        _ => (null, null),
    };

    // Extracts the tool name from a tool-result event so the matching resource lights up only once the
    // external resource has actually been contacted (never on tool-call, which is just the LLM's request).
    // Returns null for other steps. The tool-result label is "Tool → Harness: Name".
    private static string? ToolNameFor(FlowEvent flowEvent)
    {
        var label = flowEvent.Label;
        var marker = flowEvent.Kind switch
        {
            "tool-result" => "Harness: ",
            _ => null,
        };

        if (marker is null)
        {
            return null;
        }

        var start = label.IndexOf(marker, StringComparison.Ordinal);
        if (start < 0)
        {
            return null;
        }

        var name = label[(start + marker.Length)..];
        var paren = name.IndexOf('(');
        return (paren >= 0 ? name[..paren] : name).Trim();
    }

    // Highlights a node when it is the active target. The Client and AiService are merged into one
    // "harness" node (labelled "Harness" in Expert, "Application" otherwise), and the Tools box lives
    // inside it, so received/final/tool/llm steps (active node "harness" or "tools") all light it up.
    private string NodeClass(string node)
    {
        var active = node switch
        {
            "harness" => _activeNode is "harness" or "tools",
            _ => _activeNode == node,
        };
        return active ? "active" : string.Empty;
    }

    private string ArrowClass(string arrow) => _activeArrow == arrow ? "active" : string.Empty;

    // Derives a short "response type" hint for the LLM receive arrow so the kind of the latest model
    // response (a function/tool call, or final text) is visible without scrolling the transcript.
    private static string? ResponseHintFor(FlowEvent flowEvent) => flowEvent.Kind switch
    {
        "tool-call" => "\U0001F527 function call",
        "llm-response" => "\U0001F4AC text",
        _ => null,
    };

    // Loads the workspace's skill catalogue so the harness Skills box can list it before a run. Resets
    // any loaded markers and clears the list when the selected agent does not use skills or no workspace
    // is set. Called when the agent or workspace changes.
    private async Task RefreshKnownSkillsAsync()
    {
        _knownSkills.Clear();
        _loadedSkills.Clear();

        if (!SelectedAgentSupportsSkills || string.IsNullOrWhiteSpace(_workspace))
        {
            return;
        }

        try
        {
            var response = await Ai.GetSkillsAsync(_workspace);
            if (response is not null)
            {
                _knownSkills.AddRange(response.Skills.Select(s => new SkillChip(s.Name, s.Description)));
            }
        }
        catch
        {
            // Best-effort: the catalogue is informational and the path may still be mid-edit.
        }
    }

    // Keeps the harness Skills box in sync with the run: the catalogue of skills the workspace offers
    // (parsed once from the first llm-request's instructions) and the ones the model has actually loaded.
    private void TrackSkills(FlowEvent flowEvent)
    {
        if (flowEvent.Kind == "llm-request" && _knownSkills.Count == 0 && !string.IsNullOrWhiteSpace(flowEvent.Data))
        {
            _knownSkills.AddRange(ParseKnownSkills(flowEvent.Data));
        }
        else if (flowEvent.Kind == "tool-call")
        {
            var loaded = LoadedSkillFor(flowEvent);
            if (loaded is not null)
            {
                _loadedSkills.Add(loaded);
            }
        }
    }

    // Extracts the workspace's skill catalogue from the captured llm-request payload by reading the
    // <skills> block that the harness injects into the instructions (each entry is "- name: description").
    private static IReadOnlyList<SkillChip> ParseKnownSkills(string data)
    {
        string? instructions;
        try
        {
            using var document = JsonDocument.Parse(data);
            instructions = document.RootElement.TryGetProperty("instructions", out var value)
                ? value.GetString()
                : null;
        }
        catch (JsonException)
        {
            return Array.Empty<SkillChip>();
        }

        if (string.IsNullOrEmpty(instructions))
        {
            return Array.Empty<SkillChip>();
        }

        var open = instructions.IndexOf("<skills>", StringComparison.OrdinalIgnoreCase);
        var close = instructions.IndexOf("</skills>", StringComparison.OrdinalIgnoreCase);
        if (open < 0 || close <= open)
        {
            return Array.Empty<SkillChip>();
        }

        var block = instructions[(open + "<skills>".Length)..close];
        var skills = new List<SkillChip>();
        foreach (var raw in block.Split('\n'))
        {
            var line = raw.Trim();
            if (!line.StartsWith("- ", StringComparison.Ordinal))
            {
                continue;
            }

            var entry = line[2..];
            var separator = entry.IndexOf(':');
            var name = (separator >= 0 ? entry[..separator] : entry).Trim();
            var description = separator >= 0 ? entry[(separator + 1)..].Trim() : string.Empty;
            if (name.Length > 0)
            {
                skills.Add(new SkillChip(name, description));
            }
        }

        return skills;
    }

    // Returns the known skill a ReadSkill tool-call is loading, or null when the call is not a skill load.
    // Matches by the known skill name appearing in the event text, so it works regardless of arg formatting.
    private string? LoadedSkillFor(FlowEvent flowEvent)
    {
        var text = flowEvent.Data ?? flowEvent.Label;
        if (text.IndexOf("ReadSkill", StringComparison.OrdinalIgnoreCase) < 0)
        {
            return null;
        }

        return _knownSkills
            .Select(s => s.Name)
            .FirstOrDefault(name => text.Contains(name, StringComparison.OrdinalIgnoreCase));
    }

    // Toggles whether a step's full request/response data panel is shown.
    private void ToggleStep(int sequence)
    {
        if (!_expanded.Remove(sequence))
        {
            _expanded.Add(sequence);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    // One completed exchange in the conversation transcript: the user's message, the responding agent,
    // its final reply (or error) and the full ordered flow history for that turn.
    private sealed record ConversationTurn(
        string Message,
        string? Agent,
        string Reply,
        string? Error,
        IReadOnlyList<FlowEvent> Events);

    // A skill discovered in the workspace and offered to the agent: its name and one-line description.
    private sealed record SkillChip(string Name, string Description);
}
