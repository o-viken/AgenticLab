@page "/"
@rendermode InteractiveServer

<PageTitle>Agentic AI — @_view.Roster.VendorName</PageTitle>

<div class="flow-app">
    <CascadingValue Value="_view">
        <CascadingValue Value="_run">
            <header class="flow-header">
                <div class="flow-header-text">
                    <h1>Agentic AI</h1>
                    <p>Agent workbench</p>
                </div>
                <div class="flow-header-actions">
                    <a class="discovery-link" href="/learn" target="_blank" rel="noopener noreferrer"
                       title="Agent guide (opens in a new tab)" aria-label="Agent guide (opens in a new tab)">Agent guide</a>
                        <button type="button" class="discovery-link" aria-haspopup="dialog"
                            @onclick="() => _view.Layout.DiscoveryOpen = true" title="View MCP and A2A discovery">Discovery</button>
                    <label class="check concept-toggle" title="Show or hide the right learning panel and all the contextual info buttons">
                        <input type="checkbox" @bind="_view.Concepts.ShowConcepts" /> Learn
                    </label>
                </div>
            </header>

            <div class="flow-shell">
                <VendorRail OnSelectVendor="SetVendorAsync" />

                <div class="flow-body" style="@_view.Layout.BodyStyle">
                    <SidePanel Side="PanelSide.Left" Title="Controls"
                               Collapsed="_view.Layout.LeftPanelCollapsed"
                               OnToggleCollapse="ToggleLeftPanelAsync"
                               OnResize="SetLeftWidthAsync">
                        <ControlsPanel />
                    </SidePanel>

                    <section class="flow-main-col" aria-label="Main">
                        <header class="main-panel-head">
                            <span class="main-panel-title">Agent flow · @_view.Roster.VendorName</span>
                        </header>
                        <div class="@_view.Layout.MainBodyClass">
                            <div class="flow-main-panel">
                                <FlowDiagram />
                            </div>

                            <SidePanel Side="PanelSide.Bottom" Title="Execution"
                                       Collapsed="_view.Layout.BottomPanelCollapsed"
                                       OnToggleCollapse="ToggleBottomPanelAsync"
                                       OnResize="SetBottomHeightAsync">
                                <HeaderActions>
                                    <span class="panel-meta">@ExecutionMeta</span>
                                    <button type="button" class="panel-max" @onclick="_view.Layout.ToggleBottomMaximized"
                                            title="@MaximizeTitle" aria-label="@MaximizeTitle"
                                            aria-pressed="@_view.Layout.BottomPanelMaximized">
                                        <MiniIcon Name="expand" />
                                    </button>
                                </HeaderActions>
                                <ChildContent>
                                    <ExecutionExplorer />
                                </ChildContent>
                            </SidePanel>
                        </div>
                    </section>

                    @if (_view.Layout.RightPanelVisible)
                    {
                        <SidePanel Side="PanelSide.Right" Title="Learn"
                                   Collapsed="_view.Layout.RightPanelCollapsed"
                                   OnToggleCollapse="ToggleRightPanelAsync"
                                   OnResize="SetRightWidthAsync">
                            <ConceptPanel />
                        </SidePanel>
                    }
                </div>
            </div>
        </CascadingValue>
    </CascadingValue>
</div>

@if (_view.Layout.DiscoveryOpen)
{
    <DiscoveryOverlay AllowRediscovery="@(!_run.Running)" OnClose="CloseDiscoveryAsync" />
}
