@namespace AgenticLab.Web.Components.Shared
@implements IAsyncDisposable
@inject IJSRuntime JS

@* A collapsible, resizable docked panel (a simpler take on VS Code's side bars and bottom panel). Hosts
   arbitrary content via ChildContent. When collapsed it shrinks to a thin rail with an expand button;
   expanded it shows a header (title + collapse button) and a draggable splitter on its inner edge that
   resizes it. The size itself lives on the parent .flow-body grid (as the --left-w / --right-w / --bottom-h
   CSS variables); the splitter drag updates that variable live (via panels.js) and reports the final size
   back through OnResize. Left/Right resize width; Bottom resizes height. *@
<aside class="side-panel side-@SideClass @(Collapsed ? "collapsed" : "")" aria-label="@Title">
    @if (Collapsed)
    {
        <button type="button" class="panel-rail" @onclick="Toggle"
                title="Expand the @Title panel" aria-label="Expand the @Title panel" aria-expanded="false">
            <span class="rail-chevron">@RailChevron</span>
            <span class="rail-title">@Title</span>
        </button>
    }
    else
    {
        @if (Side is PanelSide.Right or PanelSide.Bottom)
        {
            <div class="panel-splitter" @ref="_handle" title="Drag to resize" role="separator"
                 aria-orientation="@(Side == PanelSide.Bottom ? "horizontal" : "vertical")"></div>
        }
        <div class="panel-inner">
            <header class="panel-head">
                <span class="panel-title">@Title</span>
                <div class="panel-head-actions">
                    @HeaderActions
                    <button type="button" class="panel-collapse" @onclick="Toggle"
                            title="Collapse the @Title panel" aria-label="Collapse the @Title panel" aria-expanded="true">
                        @CollapseGlyph
                    </button>
                </div>
            </header>
            <div class="panel-body">
                @ChildContent
            </div>
        </div>
        @if (Side == PanelSide.Left)
        {
            <div class="panel-splitter" @ref="_handle" title="Drag to resize" role="separator" aria-orientation="vertical"></div>
        }
    }
</aside>

@code {
    private ElementReference _handle;
    private DotNetObjectReference<SidePanel>? _ref;
    private bool _wired;

    /// <summary>Which edge the panel docks to (controls the splitter edge and chevron direction).</summary>
    [Parameter] public PanelSide Side { get; set; }
    /// <summary>The panel's title, shown in its header and (rotated) on its collapsed rail.</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>An optional independent grid-size variable for another panel on the same edge.</summary>
    [Parameter] public string? SizeVariable { get; set; }

    /// <summary>Whether the panel is collapsed to a thin rail.</summary>
    [Parameter] public bool Collapsed { get; set; }

    /// <summary>Invoked when the user clicks the collapse/expand button.</summary>
    [Parameter] public EventCallback OnToggleCollapse { get; set; }

    /// <summary>Invoked with the final width (px) after the user finishes dragging the splitter.</summary>
    [Parameter] public EventCallback<int> OnResize { get; set; }

    /// <summary>The panel's content (rendered in its scrollable body).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional extra buttons rendered in the header, before the collapse button.</summary>
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    private string SideClass => Side switch
    {
        PanelSide.Left => "left",
        PanelSide.Right => "right",
        PanelSide.Bottom => "bottom",
        _ => "left",
    };

    /// <summary>The glyph on the collapsed rail's expand button (points toward where the panel will grow).</summary>
    private string RailChevron => Side switch
    {
        PanelSide.Left => "›",
        PanelSide.Right => "‹",
        PanelSide.Bottom => "▴",
        _ => "›",
    };

    /// <summary>The glyph on the expanded header's collapse button (points toward where the panel collapses).</summary>
    private string CollapseGlyph => Side switch
    {
        PanelSide.Left => "‹",
        PanelSide.Right => "›",
        PanelSide.Bottom => "▾",
        _ => "‹",
    };

    private Task Toggle() => OnToggleCollapse.InvokeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The splitter element only exists while expanded, and is recreated each time the panel
        // re-expands, so (re)wire the resizer whenever it is present and not yet wired.
        if (!Collapsed && !_wired)
        {
            _ref ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("agenticLabPanels.initResizer", _handle, _ref, SideClass, SizeVariable);
                _wired = true;
            }
            catch
            {
                // JS may be unavailable during prerender; it re-wires on the next interactive render.
            }
        }
        else if (Collapsed && _wired)
        {
            _wired = false;
        }
    }

    /// <summary>Called from panels.js when a splitter drag ends, carrying the final pixel width.</summary>
    [JSInvokable]
    public Task OnResized(int width) => OnResize.InvokeAsync(width);

    public async ValueTask DisposeAsync()
    {
        if (_ref is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("agenticLabPanels.dispose", _handle);
            }
            catch
            {
                // The circuit may already be gone; nothing else to clean up.
            }

            _ref.Dispose();
        }
    }
}
