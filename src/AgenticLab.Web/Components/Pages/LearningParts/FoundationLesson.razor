@using AgenticLab.Web.Learning

<section class="foundation-lesson" aria-label="@LessonLabel" data-story="@StageId" data-beat="@_story.Beat">
    <div class="story-toolbar" role="group" aria-label="Diagram reveals">
        <button type="button" class="icon-button" title="Previous reveal" aria-label="Previous reveal"
                disabled="@(!_story.CanPrevious)" @onclick="() => _story.Move(-1)"><MiniIcon Name="prev" /></button>
        <span class="beat-count">@(_story.Beat + 1) / @_story.Captions.Count</span>
        <button type="button" class="icon-button" title="Next reveal" aria-label="Next reveal"
                disabled="@(!_story.CanNext)" @onclick="() => _story.Move(1)"><MiniIcon Name="next" /></button>
        <button type="button" class="complete-button" disabled="@(!_story.CanNext)" @onclick="_story.Complete">
            <MiniIcon Name="expand" /> Show complete diagram
        </button>
        <button type="button" class="restart-button" disabled="@(!_story.CanPrevious)" @onclick="_story.Restart">Restart</button>
    </div>
    <p class="story-caption" role="status" aria-live="polite" aria-atomic="true">@_story.Caption</p>

    @if (StageId == "agent-landscape")
    {
        <div class="landscape" data-diagram="landscape">
            <div class="purpose-grid">
                @for (var index = 0; index < FoundationStory.Examples.Count; index++)
                {
                    var example = FoundationStory.Examples[index];
                    <div class="purpose" data-example="@example.Id">
                        <span class="purpose-number" aria-hidden="true">@((index + 1).ToString("00"))</span>
                        <strong>@example.Title</strong>
                        <span>@example.Task</span>
                    </div>
                }
            </div>
            <div class="@RevealClass(1, "foundation-connectors")" aria-hidden="true">
                @foreach (var example in FoundationStory.Examples)
                {
                    <span>&darr;</span>
                }
            </div>
            <div class="@RevealClass(1, "shared-foundation")" aria-hidden="@IsUnrevealed(1)">
                <p class="section-label">Shared agentic foundation</p>
                @CorePair()
            </div>
        </div>
    }
    else if (StageId == "model-to-agent")
    {
        <div class="composition" data-diagram="composition">
            <p class="@RevealClass(6, "trigger-line")" aria-hidden="@IsUnrevealed(6)">
                <span class="story-icon user-icon" aria-hidden="true"></span>
                User request / schedule / event <span aria-hidden="true">&darr;</span>
            </p>
            <div class="agent-boundary @(_story.Beat == 6 ? "complete" : null)">
                <p class="@RevealClass(6, "section-label")" aria-hidden="@IsUnrevealed(6)">Agent = Agent host + Model</p>
                <div class="composition-grid">
                    <div class="application-node story-node" data-node="harness">
                        <span class="story-icon application-icon" aria-hidden="true"></span>
                        <h3>Agent host</h3>
                        <p class="@RevealClass(1, "application-description")" aria-hidden="@IsUnrevealed(1)">Manages the run and executes permitted actions</p>
                        <ul class="@RevealClass(1, "node-list")" aria-hidden="@IsUnrevealed(1)">
                            <li>Gather context</li>
                            <li>Load instructions</li>
                            <li>Make tools available</li>
                            <li>Manage memory</li>
                            <li>Enforce execution controls</li>
                        </ul>
                    </div>
                    <span class="plus" aria-hidden="true">+</span>
                    <div class="model-node story-node" data-node="model">
                        <span class="story-icon model-icon" aria-hidden="true"></span>
                        <h3>Model</h3>
                        <p class="@RevealClass(3, "model-description")" aria-hidden="@IsUnrevealed(3)">Chooses what comes next; does not execute tools</p>
                        <ul class="@RevealClass(3, "node-list")" aria-hidden="@IsUnrevealed(3)">
                            <li>Reason over context</li>
                            <li>Plan the next steps</li>
                            <li>Select a tool request or final answer</li>
                        </ul>
                    </div>
                    <div class="@RevealClass(4, "exchange-paths")" aria-hidden="@IsUnrevealed(4)">
                        <div class="send-path"><span>Context + tool definitions + tool results</span><span class="path-line" aria-hidden="true"></span></div>
                        <div class="@RevealClass(5, "receive-path")" aria-hidden="@IsUnrevealed(5)"><span>Answer or tool request</span><span class="path-line" aria-hidden="true"></span></div>
                    </div>
                    <div class="@RevealClass(2, "application-tools")" aria-hidden="@IsUnrevealed(2)">
                        <span class="tool-link" aria-hidden="true">&updownarrow;</span>
                        <strong>Agent host executes tools</strong>
                        <span>Search / Calendar / Files</span>
                        <small>Subject to permissions, approvals and limits</small>
                    </div>
                </div>
            </div>
            <p class="@RevealClass(6, "outcome-line")" aria-hidden="@IsUnrevealed(6)">Outcome: answer or completed task. Controls can stop the run.</p>
        </div>
    }
    else if (StageId == "anatomy-of-agent")
    {
        <div class="example-picker anatomy-purpose-picker" role="group" aria-label="Anatomy agent purpose">
            @foreach (var purpose in FoundationStory.AnatomyPurposes)
            {
                <button type="button" aria-pressed="@(_story.AnatomyProfile.Id == purpose.Id ? "true" : "false")"
                        @onclick="() => _story.SelectAnatomyPurpose(purpose.Id)">@purpose.Title</button>
            }
        </div>
        <p class="anatomy-profile-label" aria-live="polite">@_story.AnatomyProfile.ContextLabel</p>
        <div class="anatomy-story" data-diagram="anatomy" data-purpose="@_story.AnatomyProfile.Id" data-example="@_story.Anatomy.Id">
            <section class="anatomy-part anatomy-system" data-node="instructions" data-reveal="0">
                <p class="anatomy-owner"><span class="story-icon application-icon" aria-hidden="true"></span>Shared agent host</p>
                <h3>System prompt</h3>
                <p class="anatomy-text">@_story.AnatomyProfile.SystemPrompt</p>
                <small>Standing guidance, not enforced permissions</small>
            </section>
            <section class="@RevealClass(1, "anatomy-part anatomy-catalogue")" aria-hidden="@(IsUnrevealed(1) ? "true" : "false")" data-node="available-tools" data-reveal="1">
                <p class="anatomy-owner">Agent host catalogue</p>
                <h3>Available capabilities</h3>
                <ul class="anatomy-capabilities">
                    @foreach (var capability in _story.AnatomyProfile.Capabilities)
                    {
                        <li><span>@capability.Title</span><small>@capability.Connection</small></li>
                    }
                </ul>
            </section>
            <section class="@RevealClass(2, "anatomy-part anatomy-persona")" aria-hidden="@(IsUnrevealed(2) ? "true" : "false")" inert="@IsUnrevealed(2)" data-node="anatomy-persona" data-reveal="2">
                <p class="anatomy-owner">Agent configuration</p>
                <h3>Agent persona</h3>
                <div class="anatomy-mode">
                    @if (_story.AnatomyProfile.Examples.Count > 1)
                    {
                        <div class="example-picker anatomy-picker" role="group" aria-label="Agent persona example">
                            @foreach (var example in _story.AnatomyProfile.Examples)
                            {
                                <button type="button" aria-pressed="@(_story.Anatomy.Id == example.Id ? "true" : "false")"
                                        @onclick="() => _story.SelectAnatomy(example.Id)">@example.Title</button>
                            }
                        </div>
                    }
                    else
                    {
                        <strong class="anatomy-agent-name">@_story.Anatomy.Title</strong>
                    }
                </div>
                <p class="anatomy-persona-text" aria-live="polite" aria-atomic="true">@_story.Anatomy.Persona</p>
                <small>Illustrative configuration</small>
            </section>
            <section class="@RevealClass(3, "anatomy-part anatomy-selected")" aria-hidden="@(IsUnrevealed(3) ? "true" : "false")" data-node="anatomy-selected-tools" data-reveal="3">
                <p class="anatomy-owner">Granted subset</p>
                <h3>Selected tools</h3>
                <ul class="anatomy-tool-selection" aria-label="Configured capabilities">
                    @foreach (var capability in _story.AnatomyProfile.Capabilities)
                    {
                        var selected = _story.Anatomy.ToolIds.Contains(capability.Id);
                        <li class="@(selected ? "selected" : "not-selected")" data-tool="@capability.Id" data-selected="@(selected ? "true" : "false")">
                            <span class="tool-marker" aria-hidden="true">@(selected ? "[x]" : "[ ]")</span>
                            <span>@capability.Title<span class="anatomy-sr-only">: @(selected ? "selected" : "not selected")</span></span>
                        </li>
                    }
                </ul>
            </section>
            <section class="@RevealClass(3, "anatomy-part anatomy-settings")" aria-hidden="@(IsUnrevealed(3) ? "true" : "false")" data-node="anatomy-settings" data-reveal="3">
                <p class="anatomy-owner">Runtime choices</p>
                <h3>Settings</h3>
                <div class="anatomy-model" aria-live="polite"><span class="story-icon model-icon" aria-hidden="true"></span><strong>Model choice example</strong><span>@_story.Anatomy.Model</span></div>
                <p>@_story.Anatomy.ModelReason</p>
                <small>Illustrative fit, not a required model or a product's actual deployment.</small>
                <strong>Required controls</strong>
                <p>@(_story.Anatomy.Controls ?? _story.AnatomyProfile.Controls)</p>
                <small>Agent hosts must enforce these checks outside the prompt.</small>
            </section>
            <section class="@RevealClass(4, "anatomy-part anatomy-task")" aria-hidden="@(IsUnrevealed(4) ? "true" : "false")" data-node="anatomy-task" data-reveal="4">
                <p class="anatomy-owner"><span class="story-icon user-icon" aria-hidden="true"></span>This turn</p>
                <h3>Task prompt</h3>
                <p class="anatomy-text">@_story.Anatomy.Task</p>
            </section>
            <section class="@RevealClass(5, "anatomy-part anatomy-instructions")" aria-hidden="@(IsUnrevealed(5) ? "true" : "false")" data-node="anatomy-custom-instructions" data-reveal="5">
                <p class="anatomy-owner">Workspace guidance</p>
                <h3>Custom instructions</h3>
                <p class="anatomy-text">@_story.AnatomyProfile.Instructions</p>
                <small>Included in context when applicable and enabled</small>
            </section>
            <section class="@RevealClass(6, "anatomy-part anatomy-skills")" aria-hidden="@(IsUnrevealed(6) ? "true" : "false")" data-node="anatomy-skills" data-reveal="6">
                <p class="anatomy-owner">Progressive disclosure</p>
                <h3>Skills</h3>
                <ul class="anatomy-skill-list">
                    @foreach (var skill in _story.Anatomy.Skills)
                    {
                        var loaded = _story.Beat >= 7 && skill == _story.LoadedSkill;
                        <li class="@(loaded ? "loaded" : null)"><strong>@skill.Name</strong><span>@skill.Description</span><small>@(loaded ? "Body loaded" : "Description only")</small></li>
                    }
                </ul>
            </section>
            <section class="@RevealClass(7, "anatomy-part anatomy-loaded")" aria-hidden="@(IsUnrevealed(7) ? "true" : "false")" data-reveal="7">
                <p class="anatomy-owner">Read skill &rarr; added context</p>
                <h3>@_story.LoadedSkill.Name</h3>
                <ol>
                    @foreach (var step in _story.LoadedSkill.Steps)
                    {
                        <li>@step</li>
                    }
                </ol>
                <small>Illustrative loaded body. Guidance, not extra permissions.</small>
            </section>
        </div>
    }
    else if (StageId == "agents-everywhere")
    {
        <div class="environment-story" data-diagram="environments">
            <div class="example-picker" role="group" aria-label="Agent purpose">
                @foreach (var example in FoundationStory.Examples)
                {
                    <button type="button" aria-pressed="@(_story.Example.Id == example.Id ? "true" : "false")"
                            @onclick="() => _story.SelectExample(example.Id)">@example.Title</button>
                }
            </div>
            <div class="example-context" aria-live="polite" aria-atomic="true">
                <p class="application-examples"><strong>Application examples:</strong> @_story.Example.ApplicationExamples</p>
                <h3>@_story.Example.Task</h3>
                <p><strong>Context:</strong> @_story.Example.Context</p>
            </div>
            <p class="example-caveat">Products can span several purposes. Agentic capabilities depend on the mode and configuration; the comparisons below are illustrative, not descriptions of these products.</p>
            <div class="shared-core">
                @CorePair()
                <p>Context / Instructions / Tools / Memory / Execution controls</p>
            </div>
            <div class="@RevealClass(1, "environment-grid")" aria-hidden="@IsUnrevealed(1)" aria-live="polite" aria-atomic="true">
                <section class="environment-local">
                    <h3>Local agent host</h3>
                    <p class="environment-location">On your machine</p>
                    <dl><dt>Tools</dt><dd>@_story.Example.LocalTools</dd><dt>Controls</dt><dd>@_story.Example.LocalControl</dd></dl>
                </section>
                <section class="environment-cloud">
                    <h3>Cloud agent host</h3>
                    <p class="environment-location">In a hosted runtime</p>
                    <dl><dt>Tools</dt><dd>@_story.Example.CloudTools</dd><dt>Controls</dt><dd>@_story.Example.CloudControl</dd></dl>
                </section>
                <p class="hosting-note">Either agent host can call a remote model. Hybrid arrangements are possible; this is not a security boundary.</p>
            </div>
            <div class="@RevealClass(2, "trigger-settings")" aria-hidden="@IsUnrevealed(2)" inert="@IsUnrevealed(2)">
                <label for="foundation-trigger">Trigger</label>
                <select id="foundation-trigger" value="@_story.Trigger" @onchange="args => _story.SelectTrigger(args.Value?.ToString() ?? string.Empty)">
                    @foreach (var trigger in FoundationStory.Triggers)
                    {
                        <option value="@trigger">@trigger</option>
                    }
                </select>
                <p aria-live="polite">@TriggerDescription</p>
            </div>
        </div>
    }
</section>

@code {
    /// <summary>The stable lesson identifier whose local, illustrative diagram is presented.</summary>
    [Parameter, EditorRequired] public string StageId { get; set; } = string.Empty;

    private readonly FoundationStory _story = new();
    private string LessonLabel => StageId switch
    {
        "model-to-agent" => "Build an agent",
        "agents-everywhere" => "Compare agent environments",
        "anatomy-of-agent" => "Anatomy of an agent",
        _ => "Explore the agentic landscape",
    };
    private string TriggerDescription => _story.Trigger switch
    {
        "Schedule" => "A configured time starts a task with predefined instructions.",
        "Event" => "An incoming event supplies the task and its initial context.",
        _ => "A person's request supplies the task and its initial context.",
    };

    /// <inheritdoc />
    protected override void OnParametersSet() => _story.SetStage(StageId);

    private bool IsUnrevealed(int beat) => _story.Beat < beat;
    private string RevealClass(int beat, string className) => $"{className} reveal{(IsUnrevealed(beat) ? " unrevealed" : string.Empty)}";

    private static RenderFragment CorePair() => @<div class="core-pair">
        <span><span class="story-icon application-icon" aria-hidden="true"></span>Agent host</span>
        <span class="core-connector" aria-label="Context to the model; answer or tool request to the agent host">&harr;</span>
        <span><span class="story-icon model-icon" aria-hidden="true"></span>Model</span>
    </div>;
}