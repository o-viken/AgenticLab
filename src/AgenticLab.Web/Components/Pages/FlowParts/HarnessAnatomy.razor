<div class="node harness anatomy @Run.Focus.NodeClass("harness")">
    <span class="anatomy-heading">@View.Harness.Label anatomy</span>

    @if (View.Diagram.ShowEnvironment)
    {
        <span class="env-badge @View.Agent.EnvBadgeClass" title="@View.Agent.EnvTitle">@View.Agent.EnvLabel</span>
    }
    <EnvironmentPanel />

    <div class="layer app">
        <ConceptInfoButton Id="system-prompt" Title="Learn about the system prompt" />
        <span class="layer-title"><HostSection Section="HostDetailSection.SystemPrompt" /></span>
        <span class="layer-body system-prompt-body">@View.Harness.PromptDisplay</span>
        @if (View.Harness.HasPromptText)
        {
            <button type="button"
                    class="prompt-toggle @(View.Harness.ShowFullPrompt ? "expanded" : null)"
                    title="@(View.Harness.ShowFullPrompt ? "Collapse system prompt" : "Show full system prompt")"
                    aria-label="@(View.Harness.ShowFullPrompt ? "Collapse system prompt" : "Show full system prompt")"
                    aria-expanded="@(View.Harness.ShowFullPrompt ? "true" : "false")"
                    @onclick="() => View.Harness.ShowFullPrompt = !View.Harness.ShowFullPrompt">
                <span class="chevron" aria-hidden="true">⌄</span>
            </button>
        }
        <span class="set-by">Set by application</span>
    </div>

    @if (View.Agent.SupportsInstructions && Run.Catalogs.KnownInstructions.Count > 0)
    {
        <div class="layer user instructions">
            <ConceptInfoButton Id="custom-instructions" Title="Learn about custom instructions" />
            <span class="layer-title"><HostSection Section="HostDetailSection.Instructions" /></span>
            <ul class="instruction-list">
                @foreach (var instruction in Run.Catalogs.KnownInstructions)
                {
                    <li title="@instruction.Description">@(View.Options.IsInstructionEnabled(instruction.Name) ? "[x]" : "[ ]") @instruction.Name</li>
                }
            </ul>
            <span class="set-by">Set by workspace</span>
        </div>
    }

    <div class="layer agent">
        <ConceptInfoButton Id="persona" Title="Learn about the agent persona" />
        <span class="layer-title"><HostSection Section="HostDetailSection.Persona" /></span>
        <span class="layer-body">@View.SelectedAgent — @View.Agent.Description</span>
        @if (Run.Projections.PersonaChars > 0)
        {
            <span class="layer-size" title="The agent prompt (persona) sent to the model">@Run.Projections.PersonaCharsLabel</span>
        }
        <span class="set-by">Set per agent</span>
    </div>


    @if (View.Diagram.ShowTools)
    {
    <div class="layer agent tools @Run.Focus.NodeClass("tools")">
        <ConceptInfoButton Id="tools" Title="Learn about tools" />
        <span class="layer-title"><HostSection Section="HostDetailSection.Tools" Label="Tools / MCP" /></span>
        @if (View.Agent.ToolNames.Count == 0)
        {
            <span class="layer-body">none</span>
        }
        else
        {
            <ul class="tool-checks">
                @foreach (var tool in View.Agent.ToolNames)
                {
                    <li class="@View.Agent.ToolRiskClass(tool)" title="@ChipTitle(tool)">
                        <span class="risk-dot" aria-hidden="true"></span>
                        @(View.Options.IsToolEnabled(tool) ? "[x]" : "[ ]") @tool
                    </li>
                }
            </ul>
        }
        @if (Run.Projections.ToolsChars > 0)
        {
            <span class="layer-size" title="The tool definitions (catalogue) sent to the model">@Run.Projections.ToolsCharsLabel</span>
        }
        <span class="set-by">Set per agent</span>
    </div>

    }
    <div class="layer agent">
        <ConceptInfoButton Id="settings" Title="Learn about settings" />
        <span class="layer-title"><HostSection Section="HostDetailSection.Settings" /></span>
        <span class="layer-body">Declared model: @(string.IsNullOrWhiteSpace(View.Agent.Info?.ModelId) ? "Service default" : View.Agent.Info.ModelId) · stepping: @View.Options.Mode</span>
        <span class="set-by">Set per agent</span>
    </div>

    <div class="layer user">
        <ConceptInfoButton Id="user-prompt" Title="Learn about the user prompt" />
        <span class="layer-title"><HostSection Section="HostDetailSection.UserPrompt" /></span>
        <span class="layer-body">@Run.Status.CurrentUserPrompt</span>
        <span class="set-by">Set by user</span>
    </div>

    <HostCatalogues />
    <ContextStack />
</div>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;

    // The tool's risk explanation, plus (for a workspace agent) the declared token it was mapped from.
    private string ChipTitle(string tool)
    {
        var title = View.Agent.ToolRiskTitle(tool);
        var mappedFrom = View.Agent.ToolMappedFrom(tool);
        return mappedFrom is null ? title : $"{title} · mapped from {mappedFrom}";
    }
}
