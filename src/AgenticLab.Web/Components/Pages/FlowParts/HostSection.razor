@if (View.Diagram.ExpandHarness)
{
<button id="@ButtonId" type="button" class="host-section @(Selected ? "selected" : null)"
        title="Inspect @Heading" aria-controls="details-content"
        aria-expanded="@(Selected && !View.Details.Collapsed ? "true" : "false")"
        @onclick="Open" @onclick:stopPropagation="true">
    <span>@(Label ?? Heading)</span><span class="inspect-icon" aria-hidden="true"><MiniIcon Name="expand" /></span>
</button>
}
else
{
    <span>@(Label ?? Heading)</span>
}

@code {
    [CascadingParameter] private FlowViewState View { get; set; } = default!;
    /// <summary>The single detail section this heading selects.</summary>
    [Parameter] public HostDetailSection Section { get; set; }
    /// <summary>An optional host-specific label; otherwise the shared section title is used.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>A remote agent inspected only while the agent host is expanded.</summary>
    [Parameter] public string? A2AAgentName { get; set; }

    private readonly string _agentButtonId = $"host-section-a2a-{Guid.NewGuid():N}";
    private string ButtonId => A2AAgentName is not null ? _agentButtonId
        : $"host-section-{Section}-{(Label is null ? "default" : "label")}";
    private string Heading => A2AAgentName ?? HostDetailsSelection.Title(Section);
    private bool Selected => View.Details.Section == Section
        && string.Equals(View.Details.A2AAgentName, A2AAgentName, StringComparison.OrdinalIgnoreCase);

    private void Open()
    {
        if (A2AAgentName is { } agentName) View.Details.OpenA2A(agentName);
        else View.Details.Open(Section);
    }
}