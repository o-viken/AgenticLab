@if (ShowReason && Run.BreakpointPaused)
{
    <p class="breakpoint-status" role="status">Paused: @Run.Status.BreakpointReason</p>
}
@if (Run.BreakpointError is { } error)
{
    <p class="breakpoint-error" role="alert">@error</p>
}

@code {
    /// <summary>Whether to name the holding boundary beneath the fixed execution toolbar.</summary>
    [Parameter] public bool ShowReason { get; set; } = true;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;
}