@if (Run.BreakpointPaused)
{
    <div class="breakpoint-status @(ShowReason ? "" : "bare")">
        @if (ShowReason)
        {
            <p role="status">Paused: @Run.Status.BreakpointReason</p>
        }
        <div class="bp-actions">
            <LabButton Label="Continue" Icon="play" OnClick="Run.ContinueAsync" Disabled="Run.BreakpointControlPending"
                   Title="Continue in Auto until the next breakpoint" />
            <LabButton Label="Next" Icon="next" OnClick="Run.NextAsync" Disabled="Run.BreakpointControlPending"
                   Title="Advance and switch to Manual stepping" />
            <LabButton Label="Stop" Icon="stop" Variant="danger" OnClick="Run.StopAsync" />
        </div>
    </div>
}
@if (Run.BreakpointError is { } error)
{
    <p class="breakpoint-error" role="alert">@error</p>
}

@code {
    /// <summary>Whether to name the holding boundary; off where the caller already shows it (the conversation).</summary>
    [Parameter] public bool ShowReason { get; set; } = true;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;
}