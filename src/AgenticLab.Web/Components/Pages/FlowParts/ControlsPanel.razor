<div class="controls-tabs">
    <div class="conversation-head">
        <span class="section-number" aria-hidden="true">01</span>
        <div class="tab-strip" role="tablist" aria-label="Conversation workspace" @onkeydown="OnTabKeyDownAsync">
            <button @ref="_conversationTab" type="button" role="tab" id="conversation-tab" aria-controls="conversation-panel"
                    aria-selected="@(View.ActiveControlsTab == ControlsTab.Chat ? "true" : "false")"
                    tabindex="@(View.ActiveControlsTab == ControlsTab.Chat ? 0 : -1)"
                    @onclick="() => View.ActiveControlsTab = ControlsTab.Chat">Conversation</button>
            <button @ref="_settingsTab" type="button" role="tab" id="settings-tab" aria-controls="settings-panel"
                    aria-selected="@(View.ActiveControlsTab == ControlsTab.Settings ? "true" : "false")"
                    tabindex="@(View.ActiveControlsTab == ControlsTab.Settings ? 0 : -1)"
                    @onclick="() => View.ActiveControlsTab = ControlsTab.Settings">Settings
                @if (SettingsCount > 0) { <span class="tab-badge">@SettingsCount</span> }
            </button>
        </div>
        <div class="conversation-actions">
            <LabButton Label="New conversation" Icon="new" IconOnly="true" Variant="quiet"
                       OnClick="Run.NewConversationAsync" Disabled="Run.Running" />
            <button type="button" class="collapse-conversation" title="Collapse the Conversation panel"
                    aria-label="Collapse the Conversation panel" aria-expanded="true" @onclick="OnCollapse">&#8249;</button>
        </div>
    </div>

    <div class="tab-body conversation-body" id="conversation-panel" role="tabpanel" aria-labelledby="conversation-tab"
         hidden="@(View.ActiveControlsTab != ControlsTab.Chat)">
        <FlowChat />
    </div>
    <div class="tab-body settings-body" id="settings-panel" role="tabpanel" aria-labelledby="settings-tab"
         hidden="@(View.ActiveControlsTab != ControlsTab.Settings)">
        <FlowControls />
        <div class="layout-actions"><LabButton Label="Reset layout" Icon="expand" OnClick="OnResetLayout" /></div>
    </div>
    @if (View.ActiveControlsTab == ControlsTab.Telemetry) { <ControlsTelemetry /> }
</div>

@code {
    private ElementReference _conversationTab;
    private ElementReference _settingsTab;

    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;

    /// <summary>Collapses only the conversation column; the page retains and persists its layout.</summary>
    [Parameter] public EventCallback OnCollapse { get; set; }
    /// <summary>Restores the page's default layout without resetting conversation or execution state.</summary>
    [Parameter] public EventCallback OnResetLayout { get; set; }

    private int SettingsCount => Run.Catalogs.KnownSkills.Count + Run.Catalogs.KnownInstructions.Count;

    private async Task OnTabKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is not ("ArrowLeft" or "ArrowRight" or "Home" or "End")) return;
        View.ActiveControlsTab = args.Key switch
        {
            "Home" => ControlsTab.Chat,
            "End" => ControlsTab.Settings,
            _ => View.ActiveControlsTab == ControlsTab.Chat ? ControlsTab.Settings : ControlsTab.Chat
        };
        await (View.ActiveControlsTab == ControlsTab.Chat ? _conversationTab : _settingsTab).FocusAsync();
    }
}
