@using System.Globalization

@if (Signature.Current is null)
{
    <span class="token-note">No input request captured at this stage.</span>
}
else
{
    <div class="token-caption" title="Content-only estimates using the selected reference encoding. Provider message framing, hidden transformations and model-specific tokenization may differ.">
        @(Delta ? "Estimated input growth" : "Estimated input composition") <span>@Signature.Encoding reference</span>
    </div>
    @if (Delta)
    {
        <ul class="token-legend" title="Size comparison only, not reused content or provider cache usage.">
            <li><span class="token-swatch token-baseline"></span><span>@(Signature.Previous?.EstimatedTokens is not null ? "Previous size" : "Input size")</span></li>
            @if (Signature.EstimatedChange is not null)
            {
                <li><span class="token-swatch token-growth"></span><span>Increase</span></li>
                <li><span class="token-swatch token-decrease"></span><span>Decrease</span></li>
            }
        </ul>
    }
    else if (Signature.Current.Categories is { } categories)
    {
        <ul class="token-legend">
            @foreach (var category in categories)
            {
                <li title="@category.Label: @category.Tokens.ToString("N0") estimated tokens">
                    <span class="token-swatch token-@category.Key"></span>
                    <span>@category.Label</span><strong>@category.Tokens.ToString("N0")</strong>
                </li>
            }
        </ul>
    }
    @foreach (var request in Signature.ComparedRequests)
    {
        <section class="token-request" @key="request.Index">
            <header>
                <span>@(request == Signature.Current ? "Current" : "Previous")</span>
                <span>Model turn @request.Turn</span>
            </header>
            <div class="token-prompt" title="@request.Label">@request.Label</div>
            @if (request.EstimatedTokens is { } total && request.Categories is { } parts)
            {
                @if (Delta)
                {
                    var change = request == Signature.Current ? Signature.EstimatedChange ?? 0 : 0;
                    var baseline = total - Math.Max(change, 0);
                    <div class="token-row token-delta-row">
                        <div class="token-delta-track" role="img" aria-label="@DeltaLabel(total, change)">
                            <span class="token-segment token-baseline" style="width:@Width(baseline)" title="Input size: @baseline.ToString("N0") tokens"></span>
                            @if (change > 0)
                            {
                                <span class="token-segment token-growth" style="width:@Width(change)" title="Increase: +@change.ToString("N0") tokens"></span>
                            }
                            else if (change < 0)
                            {
                                <span class="token-segment token-decrease" style="width:@Width(-change)" title="Decrease: @change.ToString("N0") tokens"></span>
                            }
                        </div>
                        <span class="token-total">~@total.ToString("N0") tokens</span>
                    </div>
                }
                else
                {
                <div class="token-row">
                    <div class="token-bar" role="img" aria-label="@BarLabel(request)">
                        @foreach (var category in parts.Where(category => category.Tokens > 0))
                        {
                            var percent = total > 0 ? category.Tokens * 100.0 / total : 0;
                            <span class="token-segment token-@category.Key" style="width:@(percent.ToString("0.##", CultureInfo.InvariantCulture))%"
                                  title="@category.Label: @category.Tokens.ToString("N0") estimated tokens">
                                @if (percent >= 15)
                                {
                                    <span>@category.Tokens.ToString("N0")</span>
                                }
                            </span>
                        }
                    </div>
                    <span class="token-total">~@total.ToString("N0") tokens</span>
                </div>
                }
            }
            else
            {
                <span class="token-note">Estimate unavailable for this captured input.</span>
            }
            <dl class="token-metrics" title="Provider-reported counts for this model call only; the conversation footer sums all calls in the exchange.">
                <div><dt>Actual input</dt><dd>@request.ActualInputLabel</dd></div>
                <div><dt>Cached input</dt><dd>@request.CachedInputLabel</dd></div>
                @if (Delta && request == Signature.Current && Signature.Previous is not null)
                {
                    <div title="Input-size change, not content reuse or cached tokens."><dt>Estimated change</dt><dd>@(Signature.EstimatedChange is { } change ? $"{change:+0;-0;0} tokens" : "unavailable")</dd></div>
                }
            </dl>
        </section>
    }
}

@code {
    [CascadingParameter] private FlowRunController Run { get; set; } = default!;
    [CascadingParameter] private FlowViewState View { get; set; } = default!;
    private PromptTokenSignatureView Signature => Run.Replay.DisplayPromptTokenSignature(View.Diagram.PromptSignatureEncoding);
    private bool Delta => View.Diagram.PromptSignatureDelta;

    private string Width(int tokens) => (tokens * 100.0 / Math.Max(Signature.MaxComparedTokens, 1)).ToString("0.####", CultureInfo.InvariantCulture) + "%";
    private static string DeltaLabel(int total, int change) => $"{total:N0} estimated input tokens; change {change:+0;-0;0} tokens";
    private static string BarLabel(PromptTokenSignatureRequest request) => string.Join(", ",
        request.Categories!.Select(category => $"{category.Label}: {category.Tokens:N0} estimated tokens"));
}