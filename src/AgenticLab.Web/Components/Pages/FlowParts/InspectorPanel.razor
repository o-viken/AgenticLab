@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="inspector" @ref="_element" @onkeydown="OnKeyDown">
    <SidePanel Side="PanelSide.Right" Title="Details" SizeVariable="--details-w"
               Collapsed="View.Details.Collapsed"
               OnToggleCollapse="() => View.Details.Collapsed = !View.Details.Collapsed"
               OnResize="width => View.Details.Width = width">
        <HeaderActions>
            <button class="close-details" type="button" title="Close details" aria-label="Close details" @onclick="CloseAsync"><MiniIcon Name="close" /></button>
        </HeaderActions>
        <ChildContent>
            <div id="details-content"><HostDetailsPanel /></div>
        </ChildContent>
    </SidePanel>
</div>

@code {
    [CascadingParameter] private FlowViewState View { get; set; } = default!;
    private ElementReference _element;
    private IJSObjectReference? _module;
    private int _activation = -1;

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && View.Details.Active) await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("restore", _element);
        View.Details.Close();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/host-details.js");
        if (!View.Details.Collapsed && View.Details.Active && _activation != View.Details.Activation)
        {
            _activation = View.Details.Activation;
            await _module.InvokeVoidAsync("activate", _element);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}