@if (IconPath is { } path)
{
    <span class="vendor-icon brand-icon" style="@($"--host-icon: url('{path}')")" aria-hidden="true"></span>
}
else
{
    <svg class="vendor-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9.5" cy="9.5" r="5.5" opacity=".55" /><circle cx="14.5" cy="14.5" r="5.5" opacity=".95" /></svg>
}

@code {
    /// <summary>A validated local RCL asset from an enabled module; null uses the neutral host mark.</summary>
    [Parameter]
    public string? IconPath { get; set; }
}
