@implements IExamplePanel
@implements IDisposable

<section class="windfarm-panel" aria-label="Windfarm maintenance case">
    <header class="farm-heading">
        <img src="_content/AgenticLab.Examples.Windfarm/images/windfarm.jpg" alt="Wind turbines" width="64" height="48" />
        <div><h2>Fjordvik Wind Farm</h2><LabStatus Label="Synthetic operations" Tone="warning" /></div>
        <LabButton Label="Refresh case" Icon="live" IconOnly="true" Variant="quiet" OnClick="RefreshAsync" Disabled="@Locked" />
    </header>
    <div class="scenario-row">
        <LabField For="windfarm-scenario" Label="Scenario">
            <select id="windfarm-scenario" @bind="_scenario" disabled="@Locked">
                @foreach (var scenario in _state.Scenarios)
                {
                    <option value="@scenario.Id">@scenario.Name</option>
                }
            </select>
        </LabField>
        <LabButton Label="@(_state.Snapshot is null ? "Start case" : "Reset case")" Icon="new"
                   OnClick="StartAsync" Busy="_state.Busy" Disabled="@(Context.Running || _state.Scenarios.Count == 0)" />
    </div>
    @if (_state.Error is { } error)
    {
        <p class="case-error" role="alert">@error</p>
    }
    @if (_state.Snapshot is { } current)
    {
        <div class="case-status">
            <strong>@current.Scenario.AssetId</strong>
            <LabStatus Label="@StageLabel(current.Stage)" Tone="@StageTone(current.Stage)" Busy="Context.Running" />
            <span class="case-id" title="@current.Id">@current.Id[..8] / r@(current.Revision)</span>
        </div>
        @if (current.Draft is { } draft)
        {
            <details class="proposal" open="@(current.Stage == CaseStage.AwaitingApproval)">
                <summary>Maintenance proposal</summary>
                <p>@draft.Task</p>
                <dl>
                    <div><dt>Window (UTC)</dt><dd>@draft.Option.Start.ToString("dd MMM HH:mm") - @draft.Option.End.ToString("HH:mm")</dd></div>
                    <div><dt>Crew</dt><dd>@draft.Option.CrewId</dd></div>
                    <div><dt>Parts</dt><dd>@draft.Option.PartQuantity x @draft.Option.PartCode</dd></div>
                    <div><dt>Estimated loss</dt><dd>@draft.Option.EstimatedLostMwh.ToString("0.0") MWh</dd></div>
                </dl>
                <p>@draft.Rationale</p>
                <ul class="reviews">
                    @foreach (var reviewer in WindfarmProcess.Reviewers)
                    {
                        var review = current.Reviews.FirstOrDefault(item => item.AgentName == reviewer);
                        <li><strong>@reviewer.Replace("windfarm-", "")</strong>: @(review?.Verdict.ToString() ?? "Not reviewed")
                            @if (review is not null) { <span>@review.Observations</span> }
                        </li>
                    }
                </ul>
                <details><summary>@draft.SourceIds.Count evidence references</summary><ul class="sources">
                    @foreach (var source in draft.SourceIds) { <li>@source</li> }
                </ul></details>
            </details>
        }
        @if (current.Stage == CaseStage.AwaitingApproval)
        {
            <div class="decision">
                <LabField For="windfarm-reason" Label="Decision note (optional)">
                    <input id="windfarm-reason" @bind="_reason" maxlength="2000" disabled="@Locked" />
                </LabField>
                <div class="decision-actions">
                    <LabButton Label="Approve plan" Variant="primary" OnClick="ApproveAsync" Disabled="@(!_state.CanDecide)" />
                    <LabButton Label="Reject plan" Variant="danger" OnClick="RejectAsync" Disabled="@(!_state.CanDecide)" />
                </div>
                <span class="proposal-id" title="@current.ProposalHash">Proposal @(current.ProposalHash![..12])</span>
            </div>
        }
        @if (current.Order is { } order)
        {
            <p class="order-receipt"><strong>@order.Id</strong><span>@order.Status</span></p>
        }
        <details class="audit"><summary>Case history (@current.Audit.Count)</summary><ol>
            @foreach (var entry in current.Audit)
            {
                <li><strong>@entry.Action</strong><span>@entry.Detail</span></li>
            }
        </ol></details>
    }
</section>